[منصة-ادارة-التنويم_27.html](https://github.com/user-attachments/files/30388027/-.-._27.html)
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>منصة إدارة التنويم | مستشفى الحمادي</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
:root{
  --brand:#1855A4; --brand-dark:#0E3E7C; --brand-darker:#092A56; --brand-light:#4A7CC4;
  --brand-tint:#EAF1FA; --brand-tint2:#D6E4F5;
  --ink:#12213B; --ink-soft:#4C5C77; --line:#DCE4F0; --bg:#F3F6FB; --card:#FFFFFF;
  --font-head:'Times New Roman (Headings CS)','Times New Roman',serif;
}
*{box-sizing:border-box; margin:0; padding:0;}
body{background:var(--bg); color:var(--ink); font-family:var(--font-head); min-height:100vh;}
button, select, input, textarea{font-family:var(--font-head);}
a{color:inherit; text-decoration:none;}

/* ===== LOGIN ===== */
#loginScreen{
  min-height:100vh; display:flex; align-items:center; justify-content:center;
  background:linear-gradient(135deg,var(--brand-darker),var(--brand));
  padding:20px;
}
.login-card{
  background:#fff; border-radius:18px; padding:40px 36px; width:100%; max-width:400px;
  box-shadow:0 30px 70px rgba(9,20,40,.35); text-align:center;
}
.login-card .logo-mark{
  width:64px;height:64px;border-radius:16px;background:var(--brand-tint); color:var(--brand-darker);
  display:flex;align-items:center;justify-content:center; font-weight:bold; font-size:24px; margin:0 auto 14px;
}
.login-card h1{font-size:20px; color:var(--brand-darker); margin-bottom:4px;}
.login-card p{font-size:13px; color:var(--ink-soft); margin-bottom:22px;}
.role-list{display:flex; flex-direction:column; gap:10px; text-align:right;}
.role-btn{
  border:1px solid var(--line); background:var(--brand-tint); border-radius:10px;
  padding:12px 16px; cursor:pointer; font-size:14px; font-weight:700; color:var(--ink);
  display:flex; justify-content:space-between; align-items:center;
}
.role-btn:hover{border-color:var(--brand); background:var(--brand-tint2);}
.role-btn small{font-weight:400; color:var(--ink-soft); font-size:11.5px;}
.branch-select{margin-top:16px; display:none;}
.branch-select select{width:100%; padding:10px; border-radius:8px; border:1px solid var(--line); background:var(--brand-tint);}
.login-note{font-size:11px; color:var(--ink-soft); margin-top:18px;}

/* ===== APP SHELL ===== */
#appShell{display:none; min-height:100vh; grid-template-columns:230px 1fr;}
#appShell.show{display:grid;}
.sidebar{
  background:linear-gradient(180deg,var(--brand-darker),var(--brand-dark));
  color:#fff; padding:18px 14px; display:flex; flex-direction:column; gap:4px;
  position:sticky; top:0; height:100vh; overflow-y:auto;
}
.side-brand{display:flex; align-items:center; gap:10px; padding:6px 8px 18px;}
.side-brand .mark{width:38px;height:38px;border-radius:10px;background:#fff; color:var(--brand-darker); display:flex;align-items:center;justify-content:center; font-weight:bold;}
.side-brand div{font-size:13px; font-weight:700; line-height:1.3;}
.side-brand small{opacity:.75; font-size:10.5px; font-weight:400;}
.nav-item{
  display:flex; align-items:center; gap:10px; padding:11px 12px; border-radius:9px;
  cursor:pointer; font-size:13.5px; font-weight:700; color:rgba(255,255,255,.85);
}
.nav-item:hover{background:rgba(255,255,255,.08);}
.nav-item.active{background:#fff; color:var(--brand-darker);}
.nav-item .ic{width:18px; text-align:center;}
.side-foot{margin-top:auto; padding:12px 8px; font-size:11px; opacity:.7;}

.mainpane{min-height:100vh; display:flex; flex-direction:column;}
.topbar{
  background:var(--card); border-bottom:1px solid var(--line); padding:14px 26px;
  display:flex; align-items:center; gap:16px; position:sticky; top:0; z-index:15;
}
.topbar h2{font-size:17px; color:var(--brand-darker);}
.topbar .crumb{font-size:12px; color:var(--ink-soft);}
.searchbox{
  margin-inline-start:auto; border:1px solid var(--line); background:var(--brand-tint);
  border-radius:8px; padding:8px 14px; font-size:13px; width:230px;
}
.userchip{display:flex; align-items:center; gap:8px; font-size:12.5px; background:var(--brand-tint); padding:6px 12px; border-radius:999px; color:var(--brand-darker); font-weight:700;}
.logout-btn{border:none; background:var(--brand); color:#fff; padding:8px 14px; border-radius:8px; font-size:12.5px; font-weight:700; cursor:pointer;}

#view{padding:24px 26px 60px; max-width:1400px; width:100%; margin:0 auto;}

.section-title{font-size:16px; font-weight:700; color:var(--brand-darker); margin:26px 0 12px; display:flex; align-items:center; gap:10px;}
.section-title::before{content:""; width:5px; height:18px; background:var(--brand); border-radius:3px;}
.section-title:first-child{margin-top:0;}

.kpi-grid{display:grid; grid-template-columns:repeat(auto-fit, minmax(180px,1fr)); gap:14px;}
.kpi{background:var(--card); border:1px solid var(--line); border-radius:14px; padding:15px 17px; position:relative; overflow:hidden;}
.kpi::after{content:""; position:absolute; inset-inline-start:0; top:0; bottom:0; width:4px; background:var(--brand);}
.kpi.warn::after{background:var(--brand-darker);}
.kpi .l{font-size:12px; color:var(--ink-soft); font-weight:700;}
.kpi .v{font-size:26px; font-weight:700; color:var(--brand-darker); margin-top:5px;}
.kpi .s{font-size:11px; color:var(--ink-soft); margin-top:3px;}

.grid-2{display:grid; grid-template-columns:1.3fr 1fr; gap:16px;}
.grid-3{display:grid; grid-template-columns:repeat(3,1fr); gap:16px;}
@media (max-width:1000px){ .grid-2,.grid-3{grid-template-columns:1fr;} #appShell.show{grid-template-columns:1fr;} .sidebar{position:relative; height:auto;} }

.panel{background:var(--card); border:1px solid var(--line); border-radius:14px; padding:17px 19px;}
.panel h3{font-size:14.5px; color:var(--brand-darker); margin-bottom:12px; display:flex; justify-content:space-between; align-items:center;}
.tag{font-size:11px; background:var(--brand-tint); color:var(--brand-darker); padding:3px 10px; border-radius:999px; font-weight:700;}

.toolbar{display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-bottom:16px;}
.toolbar select, .toolbar input{border:1px solid var(--line); background:var(--brand-tint); padding:8px 12px; border-radius:8px; font-size:13px;}
.btn{border:none; border-radius:8px; padding:9px 16px; font-size:13px; font-weight:700; cursor:pointer;}
.btn-primary{background:var(--brand); color:#fff;}
.btn-primary:hover{background:var(--brand-dark);}
.btn-ghost{background:var(--brand-tint); color:var(--brand-darker);}
.btn-sm{padding:6px 11px; font-size:12px;}

table{width:100%; border-collapse:collapse; font-size:13px;}
th,td{padding:10px 8px; text-align:center; border-bottom:1px solid var(--line);}
th{color:var(--ink-soft); font-size:11.5px; font-weight:700;}
td:first-child, th:first-child{text-align:start;}
tr.clickable{cursor:pointer;}
tr.clickable:hover{background:var(--brand-tint);}

.badge{font-size:11px; padding:3px 10px; border-radius:999px; font-weight:700; display:inline-block;}
.b-blue{background:var(--brand-tint); color:var(--brand-darker);}
.b-dark{background:var(--brand-darker); color:#fff;}
.b-mid{background:var(--brand-tint2); color:var(--brand-dark);}
.b-gray{background:#EEF1F6; color:var(--ink-soft);}

.overlay{position:fixed; inset:0; background:rgba(9,20,40,.5); display:none; align-items:center; justify-content:center; z-index:60; padding:20px;}
.overlay.show{display:flex;}
.modal{background:#fff; border-radius:16px; padding:24px; width:100%; max-width:480px; max-height:88vh; overflow-y:auto; box-shadow:0 20px 50px rgba(9,20,40,.3);}
.modal h3{color:var(--brand-darker); font-size:17px; margin-bottom:14px;}
.field{margin-bottom:13px;}
.field label{font-size:12.5px; font-weight:700; display:block; margin-bottom:5px;}
.field input, .field select, .field textarea{width:100%; border:1px solid var(--line); border-radius:8px; padding:9px 10px; font-size:13px; background:var(--brand-tint);}
.field textarea{min-height:70px; resize:vertical;}
.modal-actions{display:flex; gap:10px; margin-top:16px;}
.modal-actions .btn{flex:1;}

.patient-detail-grid{display:grid; grid-template-columns:1fr 1fr; gap:10px; font-size:13px; margin-bottom:16px;}
.patient-detail-grid div b{display:block; color:var(--ink-soft); font-size:11px; font-weight:700; margin-bottom:2px;}
.timeline-item{padding:10px 0; border-bottom:1px dashed var(--line); font-size:12.5px;}
.timeline-item:last-child{border-bottom:none;}
.timeline-item .tt{font-weight:700;}
.timeline-item .td{color:var(--ink-soft); font-size:11px; margin-top:2px;}
canvas{max-height:250px;}
.empty{padding:30px; text-align:center; color:var(--ink-soft); font-size:13px;}
</style>
</head>
<body>

<!-- ===================== LOGIN ===================== -->
<div id="loginScreen">
  <div class="login-card">
    <div class="logo-mark">AH</div>
    <h1>منصة إدارة التنويم</h1>
    <p>مستشفى الحمادي — النزهة والسويدي</p>
    <div class="role-list">
      <button class="role-btn" data-role="director" disabled>مدير إدارة التنويم <small>صلاحية كاملة</small></button>
      <button class="role-btn" data-role="supervisor" disabled>مشرف إدارة التنويم <small>صلاحية فرع واحد</small></button>
      <button class="role-btn" data-role="rep" disabled>ممثل خدمات المرضى <small>تنفيذ الجولات والمشكلات</small></button>
    </div>
    <div class="branch-select" id="supervisorSelectWrap">
      <select id="supervisorSelect"></select>
    </div>
    <div class="branch-select" id="repSelectWrap">
      <select id="repSelect"></select>
    </div>
    <div class="branch-select" id="passwordWrap">
      <input type="password" id="passwordInput" placeholder="كلمة المرور" style="width:100%; border:1px solid var(--line); border-radius:8px; padding:10px; font-size:13.5px; background:var(--brand-tint);">
    </div>
    <button class="role-btn" id="loginSubmitBtn" style="display:none; justify-content:center; background:var(--brand); color:#fff; border:none; margin-top:6px;">دخول</button>
    <p id="loginError" style="display:none; color:#B3261E; font-size:12.5px; margin-top:8px;"></p>
    <p class="login-note" id="loginStatus">جارٍ تحميل البيانات من قاعدة البيانات المشتركة...</p>
  </div>
</div>

<!-- ===================== APP SHELL ===================== -->
<div id="appShell">
  <aside class="sidebar">
    <div class="side-brand">
      <div class="mark">AH</div>
      <div>منصة إدارة التنويم<br><small>مستشفى الحمادي</small></div>
    </div>
    <div class="nav-item" data-view="dashboard"><span class="ic">▦</span> لوحة التحكم</div>
    <div class="nav-item" data-view="patients"><span class="ic">📝</span> الملاحظات</div>
    <div class="nav-item" data-view="issues"><span class="ic">⚠</span> المشكلات</div>
    <div class="nav-item" data-view="casestudies"><span class="ic">📋</span> دراسات الحالة</div>
    <div class="nav-item" data-view="tasks"><span class="ic">☑</span> المهام</div>
    <div class="nav-item" data-view="dailyreport" data-role-restrict="rep"><span class="ic">🗓️</span> التقرير اليومي</div>
    <div class="nav-item" data-view="dailyreports" data-role-restrict="director,supervisor"><span class="ic">🗂️</span> التقارير اليومية</div>
    <div class="nav-item" data-view="achievements" data-role-restrict="director,supervisor,elevatedRep"><span class="ic">🏆</span> إنجازات القسم</div>
    <div class="nav-item" data-view="repsperf" data-role-restrict="director,supervisor"><span class="ic">🎯</span> أداء الممثلين</div>
    <div class="nav-item" data-view="reports"><span class="ic">📄</span> التقارير</div>
    <div class="nav-item" data-view="analytics"><span class="ic">📈</span> التحليلات</div>
    <div class="nav-item" data-view="settings" data-role-restrict="director,supervisor"><span class="ic">⚙</span> الإعدادات</div>
    <div class="side-foot">نسخة نموذجية داخلية · v0.1</div>
  </aside>

  <div class="mainpane">
    <div class="topbar">
      <div>
        <h2 id="viewTitle">لوحة التحكم</h2>
        <div class="crumb" id="viewCrumb">الرئيسية</div>
      </div>
      <input class="searchbox" id="globalSearch" placeholder="بحث سريع...">
      <span class="userchip" id="userChip">—</span>
      <button class="btn btn-ghost btn-sm" id="changePwdBtn" style="display:none;">تغيير كلمة المرور</button>
      <button class="logout-btn" id="logoutBtn">تسجيل خروج</button>
    </div>
    <div id="view"></div>
  </div>
</div>

<!-- Change password modal -->
<div class="overlay" id="pwdOverlay">
  <div class="modal" style="max-width:400px;">
    <h3>تغيير كلمة المرور</h3>
    <div class="field"><label>كلمة المرور الحالية</label><input type="password" id="oldPwdInput"></div>
    <div class="field"><label>كلمة المرور الجديدة</label><input type="password" id="newPwdInput"></div>
    <div class="field"><label>تأكيد كلمة المرور الجديدة</label><input type="password" id="newPwdInput2"></div>
    <p id="pwdError" style="display:none; color:#B3261E; font-size:12.5px; margin-bottom:10px;"></p>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeOverlay('pwdOverlay')">إلغاء</button>
      <button class="btn btn-primary" id="savePwdBtn">حفظ</button>
    </div>
  </div>
</div>

<!-- Round modal -->
<div class="overlay" id="roundOverlay">
  <div class="modal">
    <h3 id="roundModalTitle">تنفيذ جولة</h3>
    <div class="field"><label>مستوى رضا المريض</label>
      <select id="rSatisfaction"><option>راضٍ جداً</option><option>راضٍ</option><option>محايد</option><option>غير راضٍ</option><option>غير راضٍ إطلاقاً</option></select>
    </div>
    <div class="field"><label>ملاحظات / تدخل</label><textarea id="rNotes" placeholder="وصف التدخل أو الملاحظة..."></textarea></div>
    <div class="field"><label><input type="checkbox" id="rCreateIssue"> إنشاء مشكلة تشغيلية مرتبطة</label></div>
    <div class="field"><label><input type="checkbox" id="rCreateTask"> إنشاء مهمة متابعة مرتبطة</label></div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeOverlay('roundOverlay')">إلغاء</button>
      <button class="btn btn-primary" id="saveRoundBtn">حفظ واعتماد الجولة</button>
    </div>
  </div>
</div>

<!-- Issue modal -->
<div class="overlay" id="issueOverlay">
  <div class="modal">
    <h3>مشكلة تشغيلية جديدة</h3>
    <div class="field"><label>العنوان</label><input id="iTitle" placeholder="مثال: عطل تكييف بالقسم"></div>
    <div class="field"><label>القسم</label><select id="iDept"><option value="">اختر القسم</option></select></div>
    <div class="field"><label>الجهة/الشخص المسؤول عن الحل</label><input id="iResponsible" placeholder="مثال: قسم الصيانة، أو اسم الموظف"></div>
    <div class="field"><label>الأولوية</label>
      <select id="iPriority"><option>منخفضة</option><option>متوسطة</option><option selected>عالية</option><option>عاجلة</option><option>حرجة</option></select>
    </div>
    <div class="field"><label>الوصف</label><textarea id="iDesc"></textarea></div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeOverlay('issueOverlay')">إلغاء</button>
      <button class="btn btn-primary" id="saveIssueBtn">حفظ المشكلة</button>
    </div>
  </div>
</div>

<!-- Task modal -->
<div class="overlay" id="taskOverlay">
  <div class="modal">
    <h3>مهمة جديدة</h3>
    <div class="field"><label>عنوان المهمة</label><input id="tTitle"></div>
    <div class="field"><label>وصف المهمة</label><textarea id="tDesc" placeholder="تفاصيل الطلب..."></textarea></div>
    <div class="field"><label>إسناد إلى</label><select id="tOwner"></select></div>
    <div class="field"><label>الأولوية</label>
      <select id="tPriority"><option>منخفضة</option><option selected>متوسطة</option><option>عالية</option><option>عاجلة</option></select>
    </div>
    <div class="field"><label>المدة المتاحة للتنفيذ</label>
      <select id="tDuration"><option value="2">خلال ساعتين عمل</option><option value="4">4 ساعات عمل</option><option value="24" selected>يوم عمل</option><option value="48">يومان عمل</option><option value="168">اسبوع عمل</option><option value="336">اسبوعين عمل</option><option value="720">شهر عمل</option></select>
    </div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeOverlay('taskOverlay')">إلغاء</button>
      <button class="btn btn-primary" id="saveTaskBtn">إسناد المهمة</button>
    </div>
  </div>
</div>

<!-- Case study modal -->
<div class="overlay" id="caseOverlay">
  <div class="modal" style="max-width:520px;">
    <h3 id="caseModalTitle">دراسة حالة جديدة</h3>
    <div class="field"><label>اسم المريض</label><input type="text" id="csPatientName" placeholder="اسم المريض"></div>
    <div class="field"><label>رقم الهوية / الملف</label><input type="text" id="csPatientId" placeholder="رقم الهوية أو رقم الملف"></div>
    <div class="field"><label>القسم</label><select id="csDept"></select></div>
    <div class="field"><label>رقم الغرفة</label><input type="text" id="csRoom" placeholder="رقم الغرفة"></div>
    <div class="field"><label>حالة الدراسة</label>
      <select id="csStatus"><option>مسودة</option><option selected>مكتملة</option><option>معتمدة</option></select>
    </div>
    <details style="margin:6px 0 14px;">
      <summary style="cursor:pointer; font-size:12.5px; color:var(--brand-darker); font-weight:700;">تفاصيل إضافية (اختياري)</summary>
      <div style="margin-top:10px;">
        <div class="field"><label>الخلفية الاجتماعية</label><textarea id="csBackground" placeholder="اختياري..."></textarea></div>
        <div class="field"><label>الاحتياجات</label><textarea id="csNeeds" placeholder="اختياري..."></textarea></div>
        <div class="field"><label>التوصيات</label><textarea id="csRecommendations" placeholder="اختياري..."></textarea></div>
      </div>
    </details>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeOverlay('caseOverlay')">إلغاء</button>
      <button class="btn btn-primary" id="saveCaseBtn">حفظ دراسة الحالة</button>
    </div>
  </div>
</div>

<!-- Achievement creation modal -->
<div class="overlay" id="achOverlay">
  <div class="modal">
    <h3>إنجاز جديد</h3>
    <div class="field"><label>عنوان الإنجاز</label><input id="achTitle" placeholder="عنوان مختصر وواضح"></div>
    <div class="field"><label>الموظفة المُنجِزة</label><select id="achEmployee"></select></div>
    <div class="field"><label>الفئة</label>
      <select id="achCategory" onchange="updateAchConditionalFields()">
        <option>تحسين رضا المرضى</option>
        <option>تدخل ناجح بحالة حرجة أو معقدة</option>
        <option>تقليل زمن حل المشكلات</option>
        <option>تحسين إجراءات الخروج</option>
        <option>إقناع مريض بالخروج</option>
        <option>حث ذوي المريض على الزيارة</option>
        <option>خروج مريض متعثر السداد</option>
        <option>مبادرة تحسين إجراءات العمل</option>
        <option>تدريب/تطوير مهارات الفريق</option>
        <option>توفير/ترشيد بالموارد</option>
        <option>تعاون متميز مع قسم آخر</option>
        <option>مبادرة توعوية للمرضى/المرافقين</option>
      </select>
    </div>
    <div id="achConditional"></div>
    <div class="field"><label>الوصف</label><textarea id="achDesc" placeholder="وصف مختصر لما حصل..."></textarea></div>
    <div class="field"><label>الأثر/النتيجة (اختياري)</label><input id="achImpact" placeholder="مثال: تقليل الشكاوى 20٪"></div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeOverlay('achOverlay')">إلغاء</button>
      <button class="btn btn-primary" onclick="saveAchievement()">حفظ الإنجاز</button>
    </div>
  </div>
</div>

<div class="overlay" id="notesOverlay">
  <div class="modal">
    <h3>ملاحظة/شكوى جديدة</h3>
    <div class="field"><label>اسم المريض</label><input id="nPatientName" placeholder="اسم المريض"></div>
    <div class="field"><label>رقم الملف</label><input id="nMrn" placeholder="رقم الملف الطبي"></div>
    <div class="field"><label>القسم</label><select id="nDept"></select></div>
    <div class="field"><label>نوع الشكوى</label><select id="nComplaintType"></select></div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeOverlay('notesOverlay')">إلغاء</button>
      <button class="btn btn-primary" onclick="saveNote()">حفظ الملاحظة</button>
    </div>
  </div>
</div>

<script>
/* ================= DATA MODEL ================= */
const STORE_KEY = "ipm_platform_v3";
const ROLE_LABEL = {director:"مدير إدارة التنويم", supervisor:"مشرف إدارة التنويم", rep:"ممثل خدمات المرضى"};
const DEPTS = ["قسم الأطفال","قسم الجراحة","قسم النساء والولادة","قسم الباطنية","قسم الرعاية المديدة","قسم الحضانة","قسم وحدة الفرز الطبي","قسم العناية المركزة لحديثي الولادة","قسم العناية المركزة للأطفال","قسم العناية المتوسطة للأطفال","قسم العناية المركزة للكبار","قسم المتوسطة للكبار","قسم التوليد","قسم غسيل الكلى"];

function seed(){
  const branches = ["nuzha","suwaidi"];
  const branchName = {nuzha:"فرع النزهة", suwaidi:"فرع السويدي"};
  const patients = [
    {id:"p1", name:"عبدالله السهلي", mrn:"MRN-10231", age:54, gender:"ذكر", branch:"nuzha", dept:"الباطنية", room:"301", bed:"A", doctor:"د. فهد المطيري", insurance:"بوبا", admission:"2026-07-15", status:"مقيم"},
    {id:"p2", name:"منى القحطاني", mrn:"MRN-10245", age:39, gender:"أنثى", branch:"nuzha", dept:"الجراحة", room:"305", bed:"B", doctor:"د. سارة الحربي", insurance:"التعاونية", admission:"2026-07-17", status:"مقيم"},
    {id:"p3", name:"سعيد الزهراني", mrn:"MRN-10198", age:61, gender:"ذكر", branch:"suwaidi", dept:"الأورام", room:"212", bed:"A", doctor:"د. عمر القرني", insurance:"ميدغلف", admission:"2026-07-10", status:"مقيم"},
    {id:"p4", name:"هدى المطيري", mrn:"MRN-10267", age:47, gender:"أنثى", branch:"suwaidi", dept:"العناية المركزة", room:"218", bed:"C", doctor:"د. نايف العتيبي", insurance:"بوبا", admission:"2026-07-18", status:"مقيم"},
    {id:"p5", name:"خالد العنزي", mrn:"MRN-10280", age:29, gender:"ذكر", branch:"nuzha", dept:"الجراحة", room:"110", bed:"A", doctor:"د. سارة الحربي", insurance:"وقاية", admission:"2026-07-19", status:"مقيم"},
    {id:"p6", name:"لولوة الدوسري", mrn:"MRN-10255", age:31, gender:"أنثى", branch:"suwaidi", dept:"النساء والولادة", room:"402", bed:"B", doctor:"د. منيرة آل الشيخ", insurance:"التعاونية", admission:"2026-07-16", status:"مقيم"},
  ];
  const rounds = [
    {id:"r1", patientId:"p1", type:"جولة مريض", employee:"سارة", branch:"nuzha", dept:"الباطنية", time:"2026-07-20T08:10:00", satisfaction:"راضٍ جداً", notes:"لا ملاحظات."},
    {id:"r2", patientId:"p3", type:"جولة مريض", employee:"محمد", branch:"suwaidi", dept:"الأورام", time:"2026-07-20T07:40:00", satisfaction:"محايد", notes:"استفسار عن موعد الأشعة."},
  ];
  const issues = [
    {id:"i1", title:"تجاوز SLA لطلب صيانة تكييف", dept:"العناية المركزة", branch:"suwaidi", priority:"حرجة", status:"قيد المعالجة", createdAt:"2026-07-20T06:30:00", owner:"قسم الصيانة", createdBy:"rep6"},
    {id:"i2", title:"نقص أطقم تعقيم بقسم الجراحة", dept:"الجراحة", branch:"nuzha", priority:"عالية", status:"جديدة", createdAt:"2026-07-20T07:05:00", owner:"التمريض", createdBy:"rep1"},
    {id:"i3", title:"شكوى تأخر وجبة غذائية", dept:"الباطنية", branch:"nuzha", priority:"متوسطة", status:"تم الحل", createdAt:"2026-07-19T13:20:00", owner:"التغذية", createdBy:"rep2"},
  ];
  const tasks = [
    {id:"t1", title:"متابعة حالة تغذية - غرفة 218", owner:"نورة", branch:"suwaidi", priority:"عالية", due:"2026-07-21", pct:40, status:"قيد التنفيذ"},
    {id:"t2", title:"تحديث بيانات تأمين مريض", owner:"فهد", branch:"nuzha", priority:"متوسطة", due:"2026-07-22", pct:0, status:"جديدة"},
    {id:"t3", title:"مراجعة خطة خروج مريض", owner:"ريم", branch:"suwaidi", priority:"عاجلة", due:"2026-07-20", pct:80, status:"قيد التنفيذ"},
  ];
  const reps = [
    {id:"rep1", name:"سارة العتيبي", branch:"nuzha", password:"1234"},
    {id:"rep2", name:"محمد القحطاني", branch:"nuzha", password:"1234"},
    {id:"rep3", name:"نورة الدوسري", branch:"nuzha", password:"1234"},
    {id:"rep4", name:"فهد الحربي", branch:"nuzha", password:"1234"},
    {id:"rep5", name:"ريم الشهري", branch:"suwaidi", password:"1234"},
    {id:"rep6", name:"عبدالعزيز المطيري", branch:"suwaidi", password:"1234"},
    {id:"rep7", name:"هيا الزهراني", branch:"suwaidi", password:"1234"},
    {id:"rep8", name:"خالد السبيعي", branch:"suwaidi", password:"1234"},
    {id:"rep9", name:"منال العنزي", branch:"suwaidi", password:"1234"},
  ];
  const supervisors = [
    {id:"sup1", name:"مشرفة النزهة", branch:"nuzha", password:"1234"},
    {id:"sup2", name:"مشرفة السويدي", branch:"suwaidi", password:"1234"},
  ];
  const caseStudies = [
    {id:"cs1", patientId:"p1", repId:"rep1", branch:"nuzha", date:"2026-07-18T09:00:00", background:"مريض مقيم مع الأسرة، دعم أسري جيد.", needs:"دعم نفسي بسبب القلق من الإجراء العلاجي.", recommendations:"متابعة أسبوعية وتهيئة نفسية قبل الإجراء.", status:"مكتملة"},
    {id:"cs2", patientId:"p3", repId:"rep5", branch:"suwaidi", date:"2026-07-19T10:30:00", background:"حالة مزمنة، الدعم الأسري محدود.", needs:"احتياج لدعم اجتماعي ومتابعة نفسية مستمرة.", recommendations:"إحالة للأخصائي النفسي ومتابعة دورية.", status:"معتمدة"},
    {id:"cs3", patientId:"p4", repId:"rep6", branch:"suwaidi", date:"2026-07-20T08:15:00", background:"إقامة حديثة، الأسرة متعاونة.", needs:"توضيح الخطة العلاجية للأسرة.", recommendations:"جلسة توعوية مع المرافق.", status:"مسودة"},
  ];
  return {patients, rounds, issues, tasks, reps, supervisors, caseStudies, dailyReports:[], notes:[], achievements:[], branchName, seq:200};
}
function save(){ localStorage.setItem(STORE_KEY, JSON.stringify(DATA)); }

const APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbzax0Uf08kAq9hjU_N-L-SnoMKTYCIHZtjbbP_DQWh3VKzOx0GzGre1zTJCX4uEQaQLOw/exec";
const branchNameStatic = {nuzha:"فرع النزهة", suwaidi:"فرع السويدي"};

async function pushAppend(sheet, row){
  try{
    await fetch(APPS_SCRIPT_URL, {method:'POST', headers:{'Content-Type':'text/plain;charset=utf-8'}, body: JSON.stringify({action:'append', sheet, row})});
  }catch(e){ console.error('sync append failed', sheet, e); }
}
async function pushUpdate(sheet, id, patch){
  try{
    await fetch(APPS_SCRIPT_URL, {method:'POST', headers:{'Content-Type':'text/plain;charset=utf-8'}, body: JSON.stringify({action:'update', sheet, id, patch})});
  }catch(e){ console.error('sync update failed', sheet, e); }
}

function remoteToLocal(json){
  return {
    patients: (json.Patients||[]).map(p=>({...p, age:Number(p.age)})),
    reps: json.Reps||[],
    supervisors: json.Supervisors||[],
    rounds: json.Rounds||[],
    issues: (json.Issues||[]).map(i=>{ let h=[]; try{ h=JSON.parse(i.statusHistory||"[]"); }catch(e){} return {...i, statusHistory:h}; }),
    tasks: (json.Tasks||[]).map(t=>{ let f=[]; try{ f=JSON.parse(t.followUps||"[]"); }catch(e){} return {...t, pct:Number(t.pct), followUps:f}; }),
    caseStudies: json.CaseStudies||[],
    notes: json.Notes||[],
    achievements: json.Achievements||[],
    dailyReports: (json.DailyReports||[]).map(r=>{
      let tasksArr=[], compArr=[], amaArr=[];
      try{ tasksArr = JSON.parse(r.tasks||"[]"); }catch(e){}
      try{ compArr = JSON.parse(r.complaints||"[]"); }catch(e){}
      try{ amaArr = JSON.parse(r.amaDamaCases||"[]"); }catch(e){}
      return {...r, tasks:tasksArr, complaints:compArr, amaDamaCases:amaArr};
    }),
    branchName: branchNameStatic,
    seq: 1000 + Math.floor(Math.random()*9000)
  };
}

async function seedRemoteIfEmpty(remote){
  if(remote.patients.length || remote.reps.length) return remote; // already has data, don't reseed
  const s = seed();
  document.getElementById('loginStatus').textContent = "أول تشغيل — جارٍ تهيئة قاعدة البيانات بالبيانات الأساسية...";
  const jobs = [];
  s.patients.forEach(p=> jobs.push(pushAppend('Patients', p)));
  s.reps.forEach(r=> jobs.push(pushAppend('Reps', r)));
  s.supervisors.forEach(sv=> jobs.push(pushAppend('Supervisors', sv)));
  s.rounds.forEach(r=> jobs.push(pushAppend('Rounds', r)));
  s.issues.forEach(i=> jobs.push(pushAppend('Issues', i)));
  s.tasks.forEach(t=> jobs.push(pushAppend('Tasks', t)));
  s.caseStudies.forEach(c=> jobs.push(pushAppend('CaseStudies', c)));
  await Promise.all(jobs);
  return {...s, branchName: branchNameStatic};
}

async function initData(){
  try{
    const res = await fetch(APPS_SCRIPT_URL);
    const json = await res.json();
    let remote = remoteToLocal(json);
    remote = await seedRemoteIfEmpty(remote);
    DATA = remote;
    save();
    document.getElementById('loginStatus').textContent = `متصل بقاعدة البيانات المشتركة ✓ (${DATA.reps.length} موظفة، ${(DATA.supervisors||[]).length} مشرفة)`;
  }catch(e){
    console.error('remote load failed, falling back to local cache', e);
    try{
      const raw = localStorage.getItem(STORE_KEY);
      DATA = raw ? JSON.parse(raw) : seed();
    }catch(e2){ DATA = seed(); }
    document.getElementById('loginStatus').textContent = "⚠ تعذّر الاتصال بقاعدة البيانات المشتركة (تأكد إنك تفتح الملف من رابط ويب حقيقي وليس من الجهاز أو Google Drive مباشرة). يعمل الآن على بيانات محلية مؤقتة فقط.";
  }
  if(!Array.isArray(DATA.dailyReports)) DATA.dailyReports = [];
  if(!Array.isArray(DATA.notes)) DATA.notes = [];
  if(!Array.isArray(DATA.achievements)) DATA.achievements = [];
  document.getElementById('repSelect').innerHTML = DATA.reps.map(r=>`<option value="${r.id}">${r.name} — ${DATA.branchName[r.branch]}</option>`).join('');
  document.getElementById('supervisorSelect').innerHTML = (DATA.supervisors||[]).map(s=>`<option value="${s.id}">${s.name} — ${DATA.branchName[s.branch]}</option>`).join('');
  document.querySelectorAll('.role-btn:not(#loginSubmitBtn)').forEach(b=> b.disabled = false);
}

let DATA = null;
let SESSION = {role:null, branch:null};
let currentView = "dashboard";
let activePatientId = null;
let charts = {};
initData();

/* ================= LOGIN ================= */
document.querySelectorAll('.role-btn[data-role]').forEach(b=>{
  b.addEventListener('click', ()=>{
    document.querySelectorAll('.role-btn[data-role]').forEach(x=>x.style.borderColor='var(--line)');
    b.style.borderColor='var(--brand)';
    SESSION.role = b.dataset.role;
    document.getElementById('loginError').style.display='none';
    if(SESSION.role==='director'){
      document.getElementById('supervisorSelectWrap').style.display='none';
      document.getElementById('repSelectWrap').style.display='none';
      document.getElementById('passwordWrap').style.display='block';
      document.getElementById('loginSubmitBtn').style.display='flex';
      document.getElementById('passwordInput').value='';
    }else{
      document.getElementById('supervisorSelectWrap').style.display = (SESSION.role==='supervisor')? 'block':'none';
      document.getElementById('repSelectWrap').style.display = (SESSION.role==='rep')? 'block':'none';
      document.getElementById('passwordWrap').style.display='block';
      document.getElementById('loginSubmitBtn').style.display='flex';
      document.getElementById('passwordInput').value='';
    }
  });
});

document.getElementById('passwordInput').addEventListener('keydown', e=>{ if(e.key==='Enter') document.getElementById('loginSubmitBtn').click(); });
document.getElementById('loginSubmitBtn').addEventListener('click', ()=>{
  const pwd = String(document.getElementById('passwordInput').value).trim();
  const errEl = document.getElementById('loginError');
  errEl.style.display='none';
  if(SESSION.role==='director'){
    const dir = (DATA.supervisors||[]).find(s=>s.id==='director1');
    if(!dir){ errEl.textContent="حساب المدير غير معرّف بعد بقاعدة البيانات — أضيفيه بورقة Supervisors."; errEl.style.display='block'; return; }
    if(String(dir.password).trim() !== pwd){ errEl.textContent="كلمة المرور غير صحيحة."; errEl.style.display='block'; return; }
    SESSION.supName = null; SESSION.supId = dir.id; SESSION.branch='all'; SESSION.repId=null; SESSION.repName=null;
  }else if(SESSION.role==='supervisor'){
    const sup = (DATA.supervisors||[]).find(s=>s.id===document.getElementById('supervisorSelect').value);
    if(!sup){ errEl.textContent="تعذّر إيجاد هذا الحساب — حدّثي الصفحة وحاولي مرة أخرى."; errEl.style.display='block'; return; }
    if(sup.password===undefined || sup.password===""){ errEl.textContent="هذا الحساب ما له كلمة مرور مسجّلة بعد — راجعي المدير."; errEl.style.display='block'; return; }
    if(String(sup.password).trim() !== pwd){ errEl.textContent="كلمة المرور غير صحيحة."; errEl.style.display='block'; return; }
    SESSION.supName = sup.name; SESSION.supId = sup.id; SESSION.branch = sup.branch; SESSION.repId=null; SESSION.repName=null;
  }else if(SESSION.role==='rep'){
    const rep = DATA.reps.find(r=>r.id===document.getElementById('repSelect').value);
    if(!rep){ errEl.textContent="تعذّر إيجاد هذا الحساب — حدّثي الصفحة وحاولي مرة أخرى."; errEl.style.display='block'; return; }
    if(rep.password===undefined || rep.password===""){ errEl.textContent="هذا الحساب ما له كلمة مرور مسجّلة بعد — راجعي المدير."; errEl.style.display='block'; return; }
    if(String(rep.password).trim() !== pwd){ errEl.textContent="كلمة المرور غير صحيحة."; errEl.style.display='block'; return; }
    SESSION.repId = rep.id; SESSION.repName = rep.name; SESSION.branch = rep.branch; SESSION.supName=null;
    SESSION.isElevated = String(rep.elevated||'').toUpperCase()==='TRUE';
  }
  doLogin();
});

function doLogin(){
  document.getElementById('loginScreen').style.display='none';
  document.getElementById('appShell').classList.add('show');
  const nameLabel = SESSION.repName || SESSION.supName;
  document.getElementById('userChip').textContent = (nameLabel? nameLabel+" · " : "") + ROLE_LABEL[SESSION.role] + (SESSION.branch!=='all' ? " · "+DATA.branchName[SESSION.branch] : "");
  document.getElementById('changePwdBtn').style.display = 'inline-flex';
  applyRoleVisibility();
  navigate('dashboard');
}
document.getElementById('logoutBtn').addEventListener('click', ()=>{
  document.getElementById('appShell').classList.remove('show');
  document.getElementById('loginScreen').style.display='flex';
  initData(); // refresh from the shared database on every logout/login cycle
});

document.getElementById('changePwdBtn').addEventListener('click', ()=>{
  document.getElementById('oldPwdInput').value='';
  document.getElementById('newPwdInput').value='';
  document.getElementById('newPwdInput2').value='';
  document.getElementById('pwdError').style.display='none';
  document.getElementById('pwdOverlay').classList.add('show');
});
document.getElementById('savePwdBtn').addEventListener('click', ()=>{
  const errEl = document.getElementById('pwdError');
  const oldPwd = document.getElementById('oldPwdInput').value;
  const newPwd = document.getElementById('newPwdInput').value;
  const newPwd2 = document.getElementById('newPwdInput2').value;
  const sheetName = (SESSION.role==='director' || SESSION.role==='supervisor') ? 'Supervisors' : 'Reps';
  const record = (SESSION.role==='director' || SESSION.role==='supervisor') ? (DATA.supervisors||[]).find(s=>s.id===SESSION.supId) : DATA.reps.find(r=>r.id===SESSION.repId);
  if(!record || String(record.password) !== oldPwd){ errEl.textContent="كلمة المرور الحالية غير صحيحة."; errEl.style.display='block'; return; }
  if(!newPwd || newPwd.length<4){ errEl.textContent="كلمة المرور الجديدة يجب أن تكون 4 أحرف/أرقام على الأقل."; errEl.style.display='block'; return; }
  if(newPwd !== newPwd2){ errEl.textContent="كلمة المرور الجديدة غير متطابقة في الحقلين."; errEl.style.display='block'; return; }
  record.password = newPwd;
  pushUpdate(sheetName, record.id, {password:newPwd});
  save();
  closeOverlay('pwdOverlay');
  alert("تم تغيير كلمة المرور بنجاح.");
});

function applyRoleVisibility(){
  document.querySelectorAll('.nav-item[data-role-restrict]').forEach(el=>{
    const allowed = el.dataset.roleRestrict.split(',');
    const ok = allowed.includes(SESSION.role) || (SESSION.isElevated && allowed.includes('elevatedRep'));
    el.style.display = ok ? 'flex' : 'none';
  });
}

/* ================= NAV ================= */
document.querySelectorAll('.nav-item[data-view]').forEach(el=>{
  el.addEventListener('click', ()=> navigate(el.dataset.view));
});
const VIEW_TITLES = {dashboard:["لوحة التحكم","الرئيسية"], patients:["الملاحظات","إدارة التنويم / الملاحظات"], issues:["المشكلات","إدارة التنويم / المشكلات"], casestudies:["دراسات الحالة","إدارة التنويم / دراسات الحالة"], tasks:["المهام","إدارة التنويم / المهام"], dailyreport:["التقرير اليومي","إدارة التنويم / التقرير اليومي"], dailyreports:["التقارير اليومية","إدارة التنويم / التقارير اليومية"], achievements:["إنجازات القسم","إدارة التنويم / الإنجازات"], repsperf:["أداء الممثلين","إدارة التنويم / أداء الممثلين"], reports:["مركز التقارير","إدارة التنويم / التقارير"], analytics:["مركز التحليلات","إدارة التنويم / التحليلات"], settings:["الإعدادات","إدارة التنويم / الإعدادات"]};

function navigate(v){
  currentView = v;
  document.querySelectorAll('.nav-item[data-view]').forEach(el=> el.classList.toggle('active', el.dataset.view===v));
  document.getElementById('viewTitle').textContent = VIEW_TITLES[v][0];
  document.getElementById('viewCrumb').textContent = VIEW_TITLES[v][1];
  const renderers = {dashboard:renderDashboard, patients:renderPatients, issues:renderIssues, casestudies:renderCaseStudies, tasks:renderTasks, dailyreport:renderDailyReportForm, dailyreports:renderDailyReports, achievements:renderAchievements, repsperf:renderRepsPerformance, reports:renderReports, analytics:renderAnalytics, settings:renderSettings};
  renderers[v]();
}

function scopedBranches(){ return SESSION.branch==='all' ? ['nuzha','suwaidi'] : [SESSION.branch]; }
function inScope(item){ return scopedBranches().includes(item.branch); }

/* ================= DASHBOARD ================= */
function renderDashboard(){
  const branches = scopedBranches();
  const todayStr = new Date().toISOString().slice(0,10);
  const notes = (DATA.notes||[]).filter(inScope);
  const notesOpen = notes.filter(n=>n.status==='مفتوحة');
  const notesClosed = notes.filter(n=>n.status==='مغلقة');
  const roundsToday = DATA.rounds.filter(r=>inScope(r) && (r.time||'').slice(0,10)===todayStr);
  const todaysReports = (DATA.dailyReports||[]).filter(r=>inScope(r) && r.date===todayStr);
  const visitsToday = todaysReports.reduce((s,r)=> s + (Number(r.patientsCount)||0), 0);
  const tasksOpen = DATA.tasks.filter(t=>inScope(t) && t.status!=='مكتملة');
  const amaDamaToday = todaysReports.reduce((s,r)=> s + (Number(r.amaDamaTotal)||0), 0);

  const kpis = [
    {l:"الزيارات المسجّلة اليوم", v:visitsToday, s:"من التقارير اليومية"},
    {l:"الملاحظات المفتوحة", v:notesOpen.length, s:"تحتاج متابعة", warn:notesOpen.length>0},
    {l:"الملاحظات المغلقة", v:notesClosed.length, s:"تم حلها"},
    {l:"المهام المفتوحة", v:tasksOpen.length, s:"مسندة من المدير/المشرف"},
    {l:"حالات AMA/DAMA اليوم", v:amaDamaToday, s:"من التقارير اليومية"},
  ];
  document.getElementById('view').innerHTML = `
    <div class="section-title">المؤشرات اللحظية</div>
    <div class="kpi-grid">${kpis.map(k=>`<div class="kpi ${k.warn?'warn':''}"><div class="l">${k.l}</div><div class="v">${k.v}</div><div class="s">${k.s}</div></div>`).join('')}</div>
    <div class="grid-2" style="margin-top:22px;">
      <div class="panel"><h3>مقارنة الفروع <span class="tag">جولات وملاحظات</span></h3><canvas id="chBranch"></canvas></div>
      <div class="panel"><h3>المهام القريبة من الاستحقاق</h3><div id="dashTasks"></div></div>
    </div>`;

  document.getElementById('dashTasks').innerHTML = tasksOpen.slice(0,5).map(t=>`
    <div class="timeline-item"><div class="tt">${t.title}</div><div class="td">${t.owner} · استحقاق ${t.due} · ${t.pct}٪</div></div>`).join('') || `<div class="empty">لا توجد مهام مفتوحة</div>`;

  if(charts.branch) charts.branch.destroy();
  charts.branch = new Chart(document.getElementById('chBranch'), {
    type:'bar',
    data:{ labels:branches.map(b=>DATA.branchName[b]),
      datasets:[
        {label:'الجولات اليوم', data:branches.map(b=>DATA.rounds.filter(r=>r.branch===b && (r.time||'').slice(0,10)===todayStr).length), backgroundColor:'#1855A4', borderRadius:6},
        {label:'الملاحظات المفتوحة', data:branches.map(b=>(DATA.notes||[]).filter(n=>n.branch===b && n.status==='مفتوحة').length), backgroundColor:'#8FB3DE', borderRadius:6}
      ]},
    options:{responsive:true, plugins:{legend:{labels:{font:{family:'Times New Roman'}}}}, scales:{x:{ticks:{font:{family:'Times New Roman'}}}, y:{ticks:{font:{family:'Times New Roman'}}}}}
  });
}

function badge(priority){
  const map = {"منخفضة":"b-gray","متوسطة":"b-mid","عالية":"b-blue","عاجلة":"b-dark","حرجة":"b-dark"};
  return `<span class="badge ${map[priority]||'b-gray'}">${priority}</span>`;
}
function statusBadge(status){
  const closed = ["تم الحل","مغلقة","مكتملة"];
  return `<span class="badge ${closed.includes(status)?'b-mid':'b-blue'}">${status}</span>`;
}

/* ================= PATIENTS ================= */
function renderPatients(){
  const branches = scopedBranches();
  const list = (DATA.notes||[]).filter(n=>branches.includes(n.branch));
  document.getElementById('view').innerHTML = `
    <div class="toolbar">
      <select id="nStatusFilter"><option value="">كل الحالات</option><option value="مفتوحة">مفتوحة</option><option value="مغلقة">مغلقة</option></select>
      <input id="nSearch" placeholder="بحث بالاسم أو رقم الملف...">
      <button class="btn btn-primary btn-sm" onclick="openNoteCreate()">+ ملاحظة جديدة</button>
    </div>
    <div class="panel">
      <table><thead><tr><th>المريض</th><th>رقم الملف</th><th>القسم</th><th>نوع الشكوى</th><th>الفرع</th><th>الحالة</th></tr></thead>
      <tbody id="notesBody"></tbody></table>
    </div>`;
  const draw = ()=>{
    const st = document.getElementById('nStatusFilter').value;
    const q = document.getElementById('nSearch').value.trim();
    const rows = list.filter(n=> (!st||n.status===st) && (!q || (n.patientName||'').includes(q) || (n.mrn||'').includes(q)) );
    document.getElementById('notesBody').innerHTML = rows.map(n=>{
      const canEdit = SESSION.role==='director' || (SESSION.role==='rep' && n.createdBy===SESSION.repId);
      return `<tr class="${canEdit?'clickable':''}" ${canEdit?`onclick="toggleNoteStatus('${n.id}')"`:''}>
        <td>${n.patientName}</td><td>${n.mrn||'—'}</td><td>${n.dept}</td><td>${n.complaintType}</td><td>${DATA.branchName[n.branch]}</td>
        <td><span class="badge ${n.status==='مفتوحة'?'b-dark':'b-mid'}">${n.status}</span></td>
      </tr>`;
    }).join('') || `<tr><td colspan="6" class="empty">لا توجد ملاحظات مسجّلة</td></tr>`;
  };
  document.getElementById('nStatusFilter').addEventListener('change', draw);
  document.getElementById('nSearch').addEventListener('input', draw);
  draw();
}
function openNoteCreate(){
  document.getElementById('nDept').innerHTML = '<option value="">اختر القسم</option>' + DEPTS.map(d=>`<option>${d}</option>`).join('');
  document.getElementById('nComplaintType').innerHTML = Object.keys(COMPLAINT_TYPES).map(t=>`<option>${t}</option>`).join('');
  document.getElementById('notesOverlay').classList.add('show');
}
function saveNote(){
  const name = document.getElementById('nPatientName').value.trim();
  if(!name){ alert('اكتبي اسم المريض.'); return; }
  DATA.seq++;
  const note = {id:'n'+DATA.seq, patientName:name, mrn:document.getElementById('nMrn').value, dept:document.getElementById('nDept').value, branch:SESSION.branch==='all'?'nuzha':SESSION.branch, complaintType:document.getElementById('nComplaintType').value, status:'مفتوحة', createdAt:new Date().toISOString(), createdBy:SESSION.repId||SESSION.supId||''};
  DATA.notes.push(note);
  pushAppend('Notes', note);
  save(); closeOverlay('notesOverlay');
  document.getElementById('nPatientName').value=''; document.getElementById('nMrn').value='';
  renderPatients();
}
function toggleNoteStatus(id){
  const n = DATA.notes.find(x=>x.id===id);
  if(!n) return;
  n.status = n.status==='مفتوحة' ? 'مغلقة' : 'مفتوحة';
  save(); pushUpdate('Notes', id, {status:n.status}); renderPatients();
}

/* ================= ACHIEVEMENTS ================= */
const ACH_PATIENT_CATEGORIES = ["تدخل ناجح بحالة حرجة أو معقدة","إقناع مريض بالخروج","حث ذوي المريض على الزيارة","خروج مريض متعثر السداد"];
function renderAchievements(){
  const branches = scopedBranches();
  const list = (DATA.achievements||[]).filter(a=>branches.includes(a.branch)).sort((a,b)=> new Date(b.date)-new Date(a.date));
  document.getElementById('view').innerHTML = `
    <div class="toolbar">
      <button class="btn btn-primary btn-sm" onclick="openAchievementCreate()">🏆 + إنجاز جديد</button>
    </div>
    <div class="panel">
      <table><thead><tr><th>العنوان</th><th>الموظفة</th><th>الفئة</th><th>الفرع</th><th>التاريخ</th></tr></thead>
      <tbody>${list.map(a=>`
        <tr><td>${a.title}</td><td>${a.employee}</td><td>${a.category}</td><td>${DATA.branchName[a.branch]}</td><td>${new Date(a.date).toLocaleDateString('ar-SA')}</td></tr>`).join('') || `<tr><td colspan="5" class="empty">لا توجد إنجازات مسجّلة بعد</td></tr>`}
      </tbody></table>
    </div>`;
}
function openAchievementCreate(){
  const branches = scopedBranches();
  document.getElementById('achEmployee').innerHTML = DATA.reps.filter(r=>branches.includes(r.branch)).map(r=>`<option>${r.name}</option>`).join('');
  document.getElementById('achCategory').value = "تحسين رضا المرضى";
  updateAchConditionalFields();
  document.getElementById('achOverlay').classList.add('show');
}
function updateAchConditionalFields(){
  const cat = document.getElementById('achCategory').value;
  const box = document.getElementById('achConditional');
  if(ACH_PATIENT_CATEGORIES.includes(cat)){
    box.innerHTML = `<div class="field"><label>اسم المريض</label><input id="achPatientName"></div><div class="field"><label>رقم الملف</label><input id="achMrn"></div>`;
  }else if(cat==='تعاون متميز مع قسم آخر'){
    box.innerHTML = `<div class="field"><label>القسم المتعاون</label><select id="achDept">${DEPTS.map(d=>`<option>${d}</option>`).join('')}</select></div>`;
  }else{
    box.innerHTML = '';
  }
}
function saveAchievement(){
  const title = document.getElementById('achTitle').value.trim();
  if(!title){ alert('اكتبي عنوان الإنجاز.'); return; }
  DATA.seq++;
  const ach = {
    id:'ach'+DATA.seq, title, employee:document.getElementById('achEmployee').value,
    category:document.getElementById('achCategory').value, branch:SESSION.branch==='all'?'nuzha':SESSION.branch,
    date:new Date().toISOString(), desc:document.getElementById('achDesc').value, impact:document.getElementById('achImpact').value,
    patientName:document.getElementById('achPatientName')?.value||'', mrn:document.getElementById('achMrn')?.value||'',
    dept:document.getElementById('achDept')?.value||''
  };
  DATA.achievements.push(ach);
  pushAppend('Achievements', ach);
  save(); closeOverlay('achOverlay');
  document.getElementById('achTitle').value=''; document.getElementById('achDesc').value=''; document.getElementById('achImpact').value='';
  renderAchievements();
}

/* ================= ROUNDS ================= */
function openRoundModal(patientId){
  activePatientId = patientId;
  const p = DATA.patients.find(x=>x.id===patientId);
  document.getElementById('roundModalTitle').textContent = "تنفيذ جولة — " + p.name;
  document.getElementById('rSatisfaction').value = "راضٍ جداً";
  document.getElementById('rNotes').value = "";
  document.getElementById('rCreateIssue').checked = false;
  document.getElementById('rCreateTask').checked = false;
  document.getElementById('roundOverlay').classList.add('show');
}
document.getElementById('saveRoundBtn').addEventListener('click', ()=>{
  const p = DATA.patients.find(x=>x.id===activePatientId);
  DATA.seq++;
  const round = {id:"r"+DATA.seq, patientId:p.id, type:"جولة مريض", employee:ROLE_LABEL[SESSION.role], repId:SESSION.repId||"", branch:p.branch, dept:p.dept, time:new Date().toISOString(), satisfaction:document.getElementById('rSatisfaction').value, notes:document.getElementById('rNotes').value};
  DATA.rounds.push(round);
  pushAppend('Rounds', round);
  if(document.getElementById('rCreateIssue').checked){
    DATA.seq++;
    const issue = {id:"i"+DATA.seq, title:"مشكلة أثناء جولة — "+p.name, dept:p.dept, branch:p.branch, patientId:p.id, priority:"متوسطة", status:"جديدة", createdAt:new Date().toISOString(), owner:"—", createdBy:SESSION.repId||""};
    DATA.issues.push(issue);
    pushAppend('Issues', issue);
  }
  if(document.getElementById('rCreateTask').checked){
    DATA.seq++;
    const task = {id:"t"+DATA.seq, title:"متابعة بعد جولة — "+p.name, owner:ROLE_LABEL[SESSION.role], branch:p.branch, priority:"متوسطة", due:new Date(Date.now()+86400000).toISOString().slice(0,10), pct:0, status:"جديدة"};
    DATA.tasks.push(task);
    pushAppend('Tasks', task);
  }
  save();
  closeOverlay('roundOverlay');
  navigate(currentView);
});

/* ================= ISSUES ================= */
function renderIssues(){
  const branches = scopedBranches();
  const list = DATA.issues.filter(i=>branches.includes(i.branch));
  document.getElementById('view').innerHTML = `
    <div class="toolbar">
      <select id="iStatusFilter"><option value="">كل الحالات</option><option>جديدة</option><option>قيد المعالجة</option><option>تم الحل</option><option>مغلقة</option></select>
      <button class="btn btn-primary btn-sm" onclick="openIssueCreate()">+ مشكلة جديدة</button>
    </div>
    <div class="panel">
      <table><thead><tr><th>العنوان</th><th>القسم</th><th>المسؤول</th><th>الفرع</th><th>الأولوية</th><th>الحالة</th><th>تاريخ الإنشاء</th></tr></thead>
      <tbody id="issuesBody"></tbody></table>
    </div>
    <div id="issueDetail"></div>`;
  const draw = ()=>{
    const f = document.getElementById('iStatusFilter').value;
    const rows = list.filter(i=> !f || i.status===f);
    document.getElementById('issuesBody').innerHTML = rows.map(i=>{
      const canEdit = SESSION.role==='director' || (SESSION.role==='rep' && i.createdBy===SESSION.repId);
      const statusCell = canEdit
        ? `<select onchange="changeIssueStatus('${i.id}', this.value)">${["جديدة","قيد المعالجة","تم الحل","مغلقة"].map(s=>`<option ${s===i.status?'selected':''}>${s}</option>`).join('')}</select>`
        : statusBadge(i.status);
      return `<tr>
        <td class="clickable" onclick="openIssueDetail('${i.id}')">${i.title}</td><td>${i.dept}</td><td>${i.responsible||'—'}</td><td>${DATA.branchName[i.branch]}</td><td>${badge(i.priority)}</td>
        <td>${statusCell}</td>
        <td>${new Date(i.createdAt).toLocaleDateString('ar-SA')}</td>
      </tr>`;
    }).join('') || `<tr><td colspan="7" class="empty">لا توجد مشكلات</td></tr>`;
  };
  document.getElementById('iStatusFilter').addEventListener('change', draw);
  draw();
}
function openIssueCreate(){
  document.getElementById('iDept').innerHTML = '<option value="">اختر القسم</option>' + DEPTS.map(d=>`<option>${d}</option>`).join('');
  document.getElementById('issueOverlay').classList.add('show');
}
function openIssueDetail(id){
  const i = DATA.issues.find(x=>x.id===id);
  if(!i) return;
  const history = i.statusHistory || [];
  document.getElementById('issueDetail').innerHTML = `
    <div class="section-title">تفاصيل المشكلة — ${i.title}</div>
    <div class="grid-2">
      <div class="panel">
        <div class="patient-detail-grid">
          <div><b>القسم</b>${i.dept||'—'}</div>
          <div><b>المسؤول عن الحل</b>${i.responsible||'—'}</div>
          <div><b>الأولوية</b>${i.priority}</div>
          <div><b>الحالة الحالية</b>${i.status}</div>
          <div><b>تاريخ الإنشاء</b>${new Date(i.createdAt).toLocaleString('ar-SA')}</div>
          <div><b>تاريخ الحل</b>${i.resolvedAt? new Date(i.resolvedAt).toLocaleString('ar-SA') : '—'}</div>
        </div>
        <div style="margin-top:10px;"><b style="font-size:12px; color:var(--ink-soft);">الوصف:</b><p style="font-size:13px; margin-top:4px;">${i.desc||'—'}</p></div>
        ${i.closureReason?`<div style="margin-top:10px;"><b style="font-size:12px; color:var(--ink-soft);">سبب الإغلاق/الحل:</b><p style="font-size:13px; margin-top:4px;">${i.closureReason}</p></div>`:''}
      </div>
      <div class="panel">
        <h3>السجل الزمني</h3>
        ${history.map(h=>`<div class="timeline-item"><div class="tt">${h.from} ← ${h.to}</div><div class="td">${new Date(h.at).toLocaleString('ar-SA')}${h.reason?' · '+h.reason:''}</div></div>`).join('') || '<p class="empty">لا يوجد تغييرات مسجّلة بعد</p>'}
      </div>
    </div>`;
}
function changeIssueStatus(id, status){
  const i = DATA.issues.find(x=>x.id===id);
  const prevStatus = i.status;
  let closureReason = null;
  if((status==='تم الحل' || status==='مغلقة') && prevStatus!==status){
    closureReason = prompt('اكتبي سبب/ملخص الحل قبل إغلاق المشكلة:');
    if(!closureReason){ renderIssues(); return; }
  }
  i.status = status;
  if(!i.statusHistory) i.statusHistory = [];
  i.statusHistory.push({from:prevStatus, to:status, at:new Date().toISOString(), reason:closureReason});
  const patch = {status};
  if(closureReason){ i.closureReason = closureReason; i.resolvedAt = new Date().toISOString(); patch.closureReason = closureReason; patch.resolvedAt = i.resolvedAt; }
  patch.statusHistory = JSON.stringify(i.statusHistory);
  save(); pushUpdate('Issues', id, patch); renderIssues();
}
document.getElementById('saveIssueBtn').addEventListener('click', ()=>{
  const title = document.getElementById('iTitle').value.trim();
  if(!title) return;
  DATA.seq++;
  const issue = {id:"i"+DATA.seq, title, dept:document.getElementById('iDept').value||"—", responsible:document.getElementById('iResponsible').value||"—", branch:SESSION.branch==='all'?'nuzha':SESSION.branch, priority:document.getElementById('iPriority').value, status:"جديدة", createdAt:new Date().toISOString(), owner:"—", desc:document.getElementById('iDesc').value, createdBy:SESSION.repId||null, statusHistory:[]};
  DATA.issues.push(issue);
  pushAppend('Issues', {...issue, statusHistory:JSON.stringify(issue.statusHistory)});
  save(); closeOverlay('issueOverlay');
  document.getElementById('iTitle').value=''; document.getElementById('iDept').value=''; document.getElementById('iResponsible').value=''; document.getElementById('iDesc').value='';
  renderIssues();
});

/* ================= CASE STUDIES ================= */
function renderCaseStudies(){
  const branches = scopedBranches();
  let list = DATA.caseStudies.filter(c=>branches.includes(c.branch));
  if(SESSION.role==='rep') list = list.filter(c=>c.repId===SESSION.repId);
  document.getElementById('view').innerHTML = `
    <div class="toolbar">
      <select id="csStatusFilter"><option value="">كل الحالات</option><option>مسودة</option><option>مكتملة</option><option>معتمدة</option></select>
      <button class="btn btn-primary btn-sm" onclick="openCaseModal()">+ دراسة حالة جديدة</button>
    </div>
    <div class="panel">
      <table><thead><tr><th>المريض</th><th>القسم</th><th>الممثل</th><th>الفرع</th><th>التاريخ</th><th>الحالة</th></tr></thead>
      <tbody id="caseBody"></tbody></table>
    </div>`;
  const draw = ()=>{
    const f = document.getElementById('csStatusFilter').value;
    const rows = list.filter(c=> !f || c.status===f);
    document.getElementById('caseBody').innerHTML = rows.map(c=>{
      const rep = DATA.reps.find(r=>r.id===c.repId);
      return `<tr class="clickable" onclick="openCaseModal('${c.id}')">
        <td>${c.patientName||'—'}</td><td>${c.dept||'—'}</td><td>${rep?rep.name:'—'}</td><td>${DATA.branchName[c.branch]}</td>
        <td>${new Date(c.date).toLocaleDateString('ar-SA')}</td><td>${statusBadge(c.status)}</td></tr>`;
    }).join('') || `<tr><td colspan="6" class="empty">لا توجد دراسات حالة</td></tr>`;
  };
  document.getElementById('csStatusFilter').addEventListener('change', draw);
  draw();
}
let editingCaseId = null;
function openCaseModal(id){
  editingCaseId = id || null;
  document.getElementById('csDept').innerHTML = '<option value="">اختر القسم</option>' + DEPTS.map(d=>`<option>${d}</option>`).join('');
  if(id){
    const c = DATA.caseStudies.find(x=>x.id===id);
    document.getElementById('caseModalTitle').textContent = "تعديل دراسة حالة";
    document.getElementById('csPatientName').value = c.patientName||'';
    document.getElementById('csPatientId').value = c.patientIdNum||'';
    document.getElementById('csDept').value = c.dept||'';
    document.getElementById('csRoom').value = c.room||'';
    document.getElementById('csBackground').value = c.background||'';
    document.getElementById('csNeeds').value = c.needs||'';
    document.getElementById('csRecommendations').value = c.recommendations||'';
    document.getElementById('csStatus').value = c.status;
  }else{
    document.getElementById('caseModalTitle').textContent = "دراسة حالة جديدة";
    document.getElementById('csPatientName').value = ""; document.getElementById('csPatientId').value = "";
    document.getElementById('csRoom').value = "";
    document.getElementById('csBackground').value = ""; document.getElementById('csNeeds').value = "";
    document.getElementById('csRecommendations').value = ""; document.getElementById('csStatus').value = "مكتملة";
  }
  document.getElementById('caseOverlay').classList.add('show');
}
document.getElementById('saveCaseBtn').addEventListener('click', ()=>{
  const patientName = document.getElementById('csPatientName').value.trim();
  if(!patientName){ alert('اكتبي اسم المريض على الأقل.'); return; }
  const fields = {
    patientName,
    patientIdNum: document.getElementById('csPatientId').value,
    dept: document.getElementById('csDept').value,
    room: document.getElementById('csRoom').value,
    background: document.getElementById('csBackground').value,
    needs: document.getElementById('csNeeds').value,
    recommendations: document.getElementById('csRecommendations').value,
    status: document.getElementById('csStatus').value
  };
  if(editingCaseId){
    const c = DATA.caseStudies.find(x=>x.id===editingCaseId);
    Object.assign(c, fields);
    pushUpdate('CaseStudies', c.id, fields);
  }else{
    DATA.seq++;
    const cs = {id:"cs"+DATA.seq, repId:SESSION.repId||'', branch:SESSION.branch==='all'?'nuzha':SESSION.branch, date:new Date().toISOString(), ...fields};
    DATA.caseStudies.push(cs);
    pushAppend('CaseStudies', cs);
  }
  save(); closeOverlay('caseOverlay'); renderCaseStudies();
});

/* ================= REPS PERFORMANCE ================= */
function dateInRange(iso, from, to){
  const d = new Date(iso).getTime();
  return d >= new Date(from).getTime() && d <= (new Date(to).getTime()+86399999);
}
function renderRepsPerformance(){
  const branches = scopedBranches();
  const today = new Date(); const toStr = d=>d.toISOString().slice(0,10);
  const defaultFrom = toStr(new Date(today.getTime()-6*86400000));
  const defaultTo = toStr(today);
  document.getElementById('view').innerHTML = `
    <div class="toolbar">
      <button class="btn btn-ghost btn-sm" onclick="setRepRange('today')">اليوم</button>
      <button class="btn btn-ghost btn-sm" onclick="setRepRange('week')">هذا الأسبوع</button>
      <button class="btn btn-ghost btn-sm" onclick="setRepRange('month')">هذا الشهر</button>
      <button class="btn btn-ghost btn-sm" onclick="setRepRange('year')">هذه السنة</button>
      <button class="btn btn-ghost btn-sm" onclick="setRepRange('prev')">الفترة السابقة المماثلة</button>
      من <input type="date" id="repFrom" value="${defaultFrom}">
      إلى <input type="date" id="repTo" value="${defaultTo}">
      <button class="btn btn-primary btn-sm" onclick="drawRepsPerf()">تطبيق</button>
    </div>
    <div class="grid-2">
      <div class="panel"><h3>ترتيب الممثلين <span class="tag">دراسات حالة + مشكلات بوزن متساوٍ</span></h3>
        <table><thead><tr><th>الممثل</th><th>الفرع</th><th>دراسات الحالة</th><th>المشكلات</th><th>النقاط</th></tr></thead>
        <tbody id="repsPerfBody"></tbody></table>
      </div>
      <div class="panel"><h3>مقارنة بصرية</h3><canvas id="chReps"></canvas></div>
    </div>`;
  drawRepsPerf();
}
function setRepRange(kind){
  const today = new Date(); const toStr = d=>d.toISOString().slice(0,10);
  let from, to = toStr(today);
  if(kind==='today') from = to;
  else if(kind==='week') from = toStr(new Date(today.getTime()-6*86400000));
  else if(kind==='month') from = toStr(new Date(today.getFullYear(), today.getMonth(), 1));
  else if(kind==='year') from = toStr(new Date(today.getFullYear(), 0, 1));
  else if(kind==='prev'){
    const f = new Date(document.getElementById('repFrom').value);
    const t = new Date(document.getElementById('repTo').value);
    const span = t - f;
    to = toStr(new Date(f.getTime()-86400000));
    from = toStr(new Date(f.getTime()-86400000-span));
  }
  document.getElementById('repFrom').value = from;
  document.getElementById('repTo').value = to;
  drawRepsPerf();
}
function drawRepsPerf(){
  const branches = scopedBranches();
  const from = document.getElementById('repFrom').value;
  const to = document.getElementById('repTo').value;
  const reps = DATA.reps.filter(r=>branches.includes(r.branch));
  const rows = reps.map(r=>{
    const cs = DATA.caseStudies.filter(c=>c.repId===r.id && dateInRange(c.date, from, to)).length;
    const is = DATA.issues.filter(i=>i.createdBy===r.id && dateInRange(i.createdAt, from, to)).length;
    const score = cs + is; // equal weight
    return {r, cs, is, score};
  }).sort((a,b)=>b.score-a.score);
  document.getElementById('repsPerfBody').innerHTML = rows.map(x=>`
    <tr><td>${x.r.name}</td><td>${DATA.branchName[x.r.branch]}</td><td>${x.cs}</td><td>${x.is}</td><td><b>${x.score}</b></td></tr>`).join('') || `<tr><td colspan="5" class="empty">لا يوجد ممثلون ضمن هذا النطاق</td></tr>`;
  if(charts.reps) charts.reps.destroy();
  charts.reps = new Chart(document.getElementById('chReps'), {
    type:'bar',
    data:{ labels:rows.map(x=>x.r.name),
      datasets:[
        {label:'دراسات الحالة', data:rows.map(x=>x.cs), backgroundColor:'#1855A4', borderRadius:5},
        {label:'المشكلات', data:rows.map(x=>x.is), backgroundColor:'#8FB3DE', borderRadius:5}
      ]},
    options:{indexAxis:'y', plugins:{legend:{labels:{font:{family:'Times New Roman'}}}}, scales:{x:{ticks:{font:{family:'Times New Roman'}}}, y:{ticks:{font:{family:'Times New Roman', size:11}}}}}
  });
}

/* ================= TASKS ================= */
function renderTasks(){
  const branches = scopedBranches();
  let list = DATA.tasks.filter(t=>branches.includes(t.branch));
  const isManager = SESSION.role==='director' || SESSION.role==='supervisor';
  if(!isManager) list = list.filter(t=> t.ownerId===SESSION.repId);
  document.getElementById('view').innerHTML = `
    <div class="toolbar">
      <select id="tStatusFilter"><option value="">كل الحالات</option><option>جديدة</option><option>قيد التنفيذ</option><option>مكتملة</option></select>
      ${isManager? `<button class="btn btn-primary btn-sm" onclick="openTaskCreate()">+ مهمة جديدة</button>` : ''}
    </div>
    <div class="panel">
      <table><thead><tr><th>المهمة</th><th>مسندة إلى</th><th>الفرع</th><th>الأولوية</th><th>الاستحقاق</th><th>المتبقي</th><th>الإنجاز</th><th>الحالة</th><th></th></tr></thead>
      <tbody id="tasksBody"></tbody></table>
    </div>
    <div id="taskDetail"></div>`;
  const draw = ()=>{
    const f = document.getElementById('tStatusFilter').value;
    const rows = list.filter(t=> !f || t.status===f);
    document.getElementById('tasksBody').innerHTML = rows.map(t=>{
      const msLeft = new Date(t.due) - new Date();
      const hoursLeft = Math.round(msLeft/3600000);
      let countdown;
      if(t.status==='مكتملة') countdown = '—';
      else if(hoursLeft<0) countdown = `<span class="badge b-dark">متأخرة ${Math.abs(hoursLeft)} ساعة</span>`;
      else if(hoursLeft<24) countdown = `<span class="badge b-dark">باقي ${hoursLeft} ساعة</span>`;
      else countdown = `<span class="badge b-blue">باقي ${Math.round(hoursLeft/24)} يوم</span>`;
      const canUpdate = isManager || t.ownerId===SESSION.repId;
      const statusCell = (isManager)
        ? `<select onchange="changeTaskStatus('${t.id}', this.value)">${["جديدة","قيد التنفيذ","مكتملة"].map(s=>`<option ${s===t.status?'selected':''}>${s}</option>`).join('')}</select>`
        : `<span class="badge ${t.status==='مكتملة'?'b-mid':'b-blue'}">${t.status}</span>`;
      return `<tr>
        <td class="clickable" onclick="openTaskDetail('${t.id}')">${t.title}</td><td>${t.owner}</td><td>${DATA.branchName[t.branch]}</td><td>${badge(t.priority)}</td><td>${new Date(t.due).toLocaleString('ar-SA')}</td>
        <td>${countdown}</td><td>${t.pct}٪</td>
        <td>${statusCell}</td>
        <td>${canUpdate? `<button class="btn btn-ghost btn-sm" onclick="openTaskFollowup('${t.id}')">تحديث ✎</button>` : ''}</td>
      </tr>`;
    }).join('') || `<tr><td colspan="9" class="empty">لا توجد مهام</td></tr>`;
  };
  document.getElementById('tStatusFilter').addEventListener('change', draw);
  draw();
}
function openTaskDetail(id){
  const t = DATA.tasks.find(x=>x.id===id);
  if(!t) return;
  const followUps = t.followUps || [];
  document.getElementById('taskDetail').innerHTML = `
    <div class="section-title">تفاصيل المهمة — ${t.title}</div>
    <div class="grid-2">
      <div class="panel">
        <div class="patient-detail-grid">
          <div><b>مسندة إلى</b>${t.owner}</div><div><b>الأولوية</b>${t.priority}</div>
          <div><b>الاستحقاق</b>${new Date(t.due).toLocaleString('ar-SA')}</div><div><b>الحالة</b>${t.status}</div>
        </div>
        <div style="margin-top:10px;"><b style="font-size:12px; color:var(--ink-soft);">الوصف:</b><p style="font-size:13px; margin-top:4px;">${t.desc||'—'}</p></div>
      </div>
      <div class="panel"><h3>متابعة التنفيذ</h3>
        ${followUps.map(f=>`<div class="timeline-item"><div class="tt">${f.note}</div><div class="td">${f.by} · ${new Date(f.at).toLocaleString('ar-SA')}</div></div>`).join('') || '<p class="empty">لا توجد تحديثات بعد</p>'}
      </div>
    </div>`;
}
function openTaskFollowup(id){
  const t = DATA.tasks.find(x=>x.id===id);
  if(!t) return;
  const note = prompt('وش صار بالمهمة؟ (مثال: "رجع المريض" أو "تم التواصل مع الأهل")');
  if(!note) return;
  const done = confirm('هل هالتحديث يعني إن المهمة اكتملت بالكامل؟ (موافق = نعم، إلغاء = لسا قيد التنفيذ)');
  if(!t.followUps) t.followUps = [];
  const by = SESSION.repName || SESSION.supName || ROLE_LABEL[SESSION.role];
  t.followUps.push({note, by, at:new Date().toISOString()});
  t.status = done ? 'مكتملة' : 'قيد التنفيذ';
  t.pct = done ? 100 : Math.max(t.pct, 40);
  save();
  pushUpdate('Tasks', id, {status:t.status, pct:t.pct, followUps:JSON.stringify(t.followUps)});
  renderTasks();
}
function openTaskCreate(){
  const branches = scopedBranches();
  const assignees = [
    ...DATA.reps.filter(r=>branches.includes(r.branch)).map(r=>({id:r.id, name:r.name})),
    ...(DATA.supervisors||[]).filter(s=>s.id!=='director1' && branches.includes(s.branch)).map(s=>({id:s.id, name:s.name}))
  ];
  document.getElementById('tOwner').innerHTML = assignees.map(a=>`<option value="${a.id}">${a.name}</option>`).join('');
  document.getElementById('taskOverlay').classList.add('show');
}
function changeTaskStatus(id, status){
  const t = DATA.tasks.find(x=>x.id===id); t.status=status; t.pct = status==='مكتملة'?100:(status==='قيد التنفيذ'?Math.max(t.pct,20):t.pct); save(); pushUpdate('Tasks', id, {status:t.status, pct:t.pct}); renderTasks();
}
document.getElementById('saveTaskBtn').addEventListener('click', ()=>{
  const title = document.getElementById('tTitle').value.trim();
  if(!title) return;
  DATA.seq++;
  const hours = Number(document.getElementById('tDuration').value)||24;
  const due = new Date(Date.now()+hours*3600000).toISOString();
  const ownerSelect = document.getElementById('tOwner');
  const ownerId = ownerSelect.value;
  const ownerName = ownerSelect.options[ownerSelect.selectedIndex]?.text || '—';
  const task = {id:"t"+DATA.seq, title, desc:document.getElementById('tDesc').value, owner:ownerName, ownerId, branch:SESSION.branch==='all'?'nuzha':SESSION.branch, priority:document.getElementById('tPriority').value, due, pct:0, status:"جديدة", followUps:[]};
  DATA.tasks.push(task);
  pushAppend('Tasks', {...task, followUps:JSON.stringify(task.followUps)});
  save(); closeOverlay('taskOverlay');
  document.getElementById('tTitle').value=''; document.getElementById('tDesc').value='';
  renderTasks();
});

/* ================= REPORTS ================= */
/* ================= DAILY REPORT (rep submission) ================= */
const REPORT_DEPTS = DEPTS;
const REPORT_TASKS = ["جولة صباحية على المرضى","جولة مسائية على المرضى","تعريف المرضى بحقوقهم وتوثيقها","متابعة مرور الأطباء","متابعة إجراءات الخروج","متابعة كتابة التقارير الطبية","متابعة إخلاء الغرف بعد الخروج","التنسيق مع الأقسام الأخرى","توثيق الملاحظات في HIS"];
const COMPLAINT_TYPES = {
  'تأخر التمريض': {icon:'🩺', fields:[{id:'dept',label:'القسم',type:'select',options:REPORT_DEPTS},{id:'ward',label:'الجناح / الغرفة',type:'text'},{id:'issue',label:'نوع التأخر',type:'select',options:['تأخر الاستجابة لجرس النداء','تأخر إعطاء الدواء','تأخر تغيير الضمادة','تأخر تقليب المريض','أخرى']},{id:'detail',label:'التفاصيل',type:'textarea'}]},
  'شكوى على الوجبات': {icon:'🍽️', fields:[{id:'dept',label:'القسم',type:'select',options:REPORT_DEPTS},{id:'ward',label:'الجناح / الغرفة',type:'text'},{id:'issue',label:'نوع الشكوى',type:'select',options:['وجبة متأخرة','وجبة باردة','وجبة غير مناسبة للحالة','كمية غير كافية','جودة الطعام','أخرى']},{id:'detail',label:'التفاصيل',type:'textarea'}]},
  'مشكلة نظافة': {icon:'🧹', fields:[{id:'dept',label:'القسم',type:'select',options:REPORT_DEPTS},{id:'location',label:'الموقع',type:'text'},{id:'issue',label:'نوع المشكلة',type:'select',options:['غرفة لم تُنظَّف','دورة مياه قذرة','روائح كريهة','نفايات لم تُرفع','أخرى']},{id:'action',label:'هل تم الإبلاغ؟',type:'select',options:['نعم — تم الإبلاغ وحل','نعم — تم الإبلاغ ولم يُحل','لا']},{id:'detail',label:'تفاصيل',type:'textarea'}]},
  'طبيب لم يمر': {icon:'👨‍⚕️', fields:[{id:'dept',label:'القسم',type:'select',options:REPORT_DEPTS},{id:'ward',label:'الجناح',type:'text'},{id:'type',label:'نوع الطبيب',type:'select',options:['طبيب معالج','طبيب مناوب','طبيب استشاري']},{id:'time',label:'وقت الملاحظة',type:'text'},{id:'detail',label:'تفاصيل',type:'textarea'}]},
  'تأخر خروج مريض': {icon:'🚪', fields:[{id:'dept',label:'القسم',type:'select',options:REPORT_DEPTS},{id:'room',label:'رقم الغرفة',type:'text'},{id:'reason',label:'سبب التأخير',type:'select',options:['تأخر الطبيب في كتابة الوصفة','تأخر الصيدلية','تأخر التمريض','تأخر المحاسبة','تأخر التحصيل','المريض غير مستعد','أخرى']},{id:'time',label:'وقت قرار الخروج',type:'text'},{id:'detail',label:'تفاصيل',type:'textarea'}]},
  'مشكلة في الموافقات الطبية': {icon:'📋', fields:[{id:'dept',label:'القسم',type:'select',options:REPORT_DEPTS},{id:'issue',label:'نوع المشكلة',type:'select',options:['رفض التغطية','تأخر الموافقة','انتهاء صلاحية الموافقة','مستندات ناقصة','أخرى']},{id:'patient',label:'رقم المريض / الغرفة',type:'text'},{id:'action',label:'الإجراء المتخذ',type:'text'}]},
  'حالة اجتماعية أو نفسية': {icon:'💙', fields:[{id:'dept',label:'القسم',type:'select',options:REPORT_DEPTS},{id:'type',label:'نوع الحالة',type:'select',options:['مريض بدون دعم عائلي','حالة نفسية حرجة','نزاع عائلي','مريض من فئة خاصة','أخرى']},{id:'status',label:'حالة المتابعة',type:'select',options:['تمت المعالجة','قيد المتابعة','تم التصعيد']},{id:'detail',label:'تفاصيل الحالة',type:'textarea'}]},
  'شكوى أخرى': {icon:'📝', fields:[{id:'dept',label:'القسم',type:'select',options:REPORT_DEPTS},{id:'title',label:'موضوع الشكوى',type:'text'},{id:'detail',label:'التفاصيل',type:'textarea'}]}
};
let reportComplaints = [];
const AMA_DAMA_REASONS = ["عدم الرضا عن الخدمة المقدمة","أسباب مالية","أسباب اجتماعية أو عائلية","رغبة في التحويل لمستشفى آخر","عدم الاقتناع بالخطة العلاجية","تحسّن الحالة حسب رأي المريض/المرافق","التزامات عمل أو ظروف شخصية","أسباب دينية أو ثقافية","أخرى"];
let amaDamaCases = [];
let amaDamaSeq = 0;
let reportComplaintSeq = 0;

function renderDailyReportForm(){
  const today = new Date().toISOString().slice(0,10);
  document.getElementById('view').innerHTML = `
    <div class="panel">
      <div class="section-title" style="margin-top:0;">معلومات أساسية</div>
      <div class="field"><label>التاريخ</label><input type="date" id="drDate" value="${today}"></div>

      <div class="section-title">✅ المهام اليومية المنجزة</div>
      <div style="display:flex; flex-direction:column; gap:8px;">
        ${REPORT_TASKS.map((t,i)=>`<label style="display:flex; align-items:center; gap:8px; font-size:13px; padding:8px 10px; border:1px solid var(--line); border-radius:8px; background:var(--brand-tint);"><input type="checkbox" class="dr-task" value="${t}"> ${t}</label>`).join('')}
      </div>
      <div class="field" style="margin-top:14px;"><label>عدد الحالات التي تابعتِها اليوم</label><input type="number" id="drPatients" min="0" placeholder="0"></div>
      <div class="field"><label>أعداد الخروج للمراجعين اليوم</label><input type="number" id="drDischarge" min="0" placeholder="0"></div>
      <div class="field"><label>مدى رضا المرضى عن الخدمات الصحية والإدارية المقدمة</label>
        <select id="drSatisfaction"><option value="راضٍ تمامًا">راضٍ تمامًا</option><option value="راضٍ">راضٍ</option><option value="محايد">محايد</option><option value="غير راضٍ">غير راضٍ</option><option value="غير راضٍ إطلاقًا">غير راضٍ إطلاقًا</option></select>
      </div>
      <div class="section-title">🚪 حالات الخروج ضد النصيحة الطبية (AMA/DAMA) <span class="tag" id="drAmaDamaCount">0</span></div>
      <div id="drAmaDamaList"></div>
      <button class="btn btn-ghost" style="width:100%; margin-bottom:14px;" onclick="addAmaDamaCase()">＋ إضافة حالة AMA/DAMA</button>

      <div class="section-title">⚠️ الشكاوى والمشاكل <span class="tag" id="drComplaintCount">0</span></div>
      <div id="drComplaintsList"></div>
      <button class="btn btn-ghost" style="width:100%; margin-bottom:14px;" onclick="addReportComplaint()">＋ إضافة شكوى أو مشكلة</button>

      <div class="section-title">🔴 التحديات والتصعيد</div>
      <div class="field"><label>هل تم التصعيد لمدير التنويم اليوم؟</label>
        <select id="drEscalated"><option value="لا">لا</option><option value="نعم">نعم</option><option value="لم تكن هناك حاجة">لم تكن هناك حاجة</option></select>
      </div>
      <div class="field"><label>ملاحظات إضافية للإدارة</label><textarea id="drNotes" placeholder="أي ملاحظات أو طلبات..."></textarea></div>
      <div class="field"><label>عدد المرضى الموثَّقين في HIS</label><input type="number" id="drHis" min="0" placeholder="0"></div>

      <button class="btn btn-primary" style="width:100%; padding:12px; font-size:14px;" onclick="submitDailyReport()">📤 إرسال التقرير</button>
      <p id="drStatus" style="display:none; margin-top:10px; font-size:12.5px; text-align:center;"></p>
    </div>`;
  reportComplaints = [];
  reportComplaintSeq = 0;
  amaDamaCases = [];
  amaDamaSeq = 0;
  document.getElementById('drComplaintsList').innerHTML='';
  document.getElementById('drAmaDamaList').innerHTML='';
}

function addReportComplaint(){
  reportComplaintSeq++;
  const id = 'rc'+reportComplaintSeq;
  reportComplaints.push(id);
  const typeOptions = Object.keys(COMPLAINT_TYPES).map(t=>`<option value="${t}">${COMPLAINT_TYPES[t].icon} ${t}</option>`).join('');
  const div = document.createElement('div');
  div.className='panel';
  div.style.marginBottom='10px';
  div.id=id;
  div.innerHTML = `
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
      <b id="title-${id}" style="font-size:13px; color:var(--brand-darker);">شكوى جديدة</b>
      <button class="btn btn-ghost btn-sm" onclick="document.getElementById('${id}').remove(); updateReportComplaintCount();">حذف ✕</button>
    </div>
    <div class="field"><label>نوع المشكلة</label>
      <select id="type-${id}" onchange="updateReportComplaintFields('${id}')"><option value="">اختر نوع المشكلة</option>${typeOptions}</select>
    </div>
    <div id="dynamic-${id}"></div>
    <div class="field"><label>هل تم حل هذه الشكوى؟</label>
      <select id="resolved-${id}"><option value="">اختر الحالة</option><option>محلولة ✅</option><option>غير محلولة ❌</option><option>قيد المتابعة 🔄</option></select>
    </div>`;
  document.getElementById('drComplaintsList').appendChild(div);
  updateReportComplaintCount();
}
function updateReportComplaintFields(id){
  const type = document.getElementById('type-'+id).value;
  document.getElementById('title-'+id).textContent = type ? COMPLAINT_TYPES[type].icon+' '+type : 'شكوى جديدة';
  const box = document.getElementById('dynamic-'+id);
  if(!type){ box.innerHTML=''; return; }
  box.innerHTML = COMPLAINT_TYPES[type].fields.map(f=>{
    if(f.type==='select') return `<div class="field"><label>${f.label}</label><select id="${f.id}-${id}"><option value="">اختر</option>${f.options.map(o=>`<option>${o}</option>`).join('')}</select></div>`;
    if(f.type==='textarea') return `<div class="field"><label>${f.label}</label><textarea id="${f.id}-${id}"></textarea></div>`;
    return `<div class="field"><label>${f.label}</label><input type="text" id="${f.id}-${id}"></div>`;
  }).join('');
}
function updateReportComplaintCount(){
  document.getElementById('drComplaintCount').textContent = document.getElementById('drComplaintsList').children.length;
}
function collectReportComplaints(){
  const items = document.getElementById('drComplaintsList').children;
  const result = [];
  for(const item of items){
    const id = item.id;
    const type = document.getElementById('type-'+id)?.value;
    if(!type) continue;
    const fields = COMPLAINT_TYPES[type]?.fields || [];
    const entry = {type};
    fields.forEach(f=>{ const el=document.getElementById(f.id+'-'+id); if(el) entry[f.id]=el.value; });
    const resolvedEl = document.getElementById('resolved-'+id);
    if(resolvedEl) entry.resolved = resolvedEl.value||'';
    result.push(entry);
  }
  return result;
}

function addAmaDamaCase(){
  amaDamaSeq++;
  const id = 'ad'+amaDamaSeq;
  amaDamaCases.push(id);
  const div = document.createElement('div');
  div.className='panel';
  div.style.marginBottom='10px';
  div.id=id;
  div.innerHTML = `
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
      <b style="font-size:13px; color:var(--brand-darker);">حالة AMA/DAMA</b>
      <button class="btn btn-ghost btn-sm" onclick="document.getElementById('${id}').remove(); updateAmaDamaCount();">حذف ✕</button>
    </div>
    <div class="field"><label>اسم المريض / رقم الملف</label><input type="text" id="patient-${id}"></div>
    <div class="field"><label>القسم</label><select id="dept-${id}"><option value="">اختر</option>${REPORT_DEPTS.map(d=>`<option>${d}</option>`).join('')}</select></div>
    <div class="field"><label>الغرفة</label><input type="text" id="room-${id}"></div>
    <div class="field"><label>النتيجة</label><select id="outcome-${id}"><option value="">اختر</option><option value="تم الإقناع بالاستمرار في العلاج">تم الإقناع بالاستمرار في العلاج</option><option value="أصرّ على الخروج">أصرّ على الخروج</option></select></div>
    <div class="field"><label>سبب الخروج</label><select id="reason-${id}"><option value="">اختر</option>${AMA_DAMA_REASONS.map(r=>`<option>${r}</option>`).join('')}</select></div>
    <div class="field"><label>ملاحظات</label><textarea id="notes-${id}"></textarea></div>`;
  document.getElementById('drAmaDamaList').appendChild(div);
  updateAmaDamaCount();
}
function updateAmaDamaCount(){
  document.getElementById('drAmaDamaCount').textContent = document.getElementById('drAmaDamaList').children.length;
}
function collectAmaDamaCases(){
  const items = document.getElementById('drAmaDamaList').children;
  const result = [];
  for(const item of items){
    const id = item.id;
    const outcome = document.getElementById('outcome-'+id)?.value;
    if(!outcome) continue;
    result.push({
      patient: document.getElementById('patient-'+id)?.value||'',
      dept: document.getElementById('dept-'+id)?.value||'',
      room: document.getElementById('room-'+id)?.value||'',
      outcome,
      reason: document.getElementById('reason-'+id)?.value||'',
      notes: document.getElementById('notes-'+id)?.value||''
    });
  }
  return result;
}

function submitDailyReport(){
  const date = document.getElementById('drDate').value;
  const statusEl = document.getElementById('drStatus');
  if(!date){ statusEl.style.display='block'; statusEl.style.color='#B3261E'; statusEl.textContent='حددي التاريخ أولاً.'; return; }
  const tasks = [...document.querySelectorAll('.dr-task:checked')].map(c=>c.value);
  const complaints = collectReportComplaints();
  const amaDamaList = collectAmaDamaCases();
  const convinced = amaDamaList.filter(c=>c.outcome==='تم الإقناع بالاستمرار في العلاج').length;
  const insisted = amaDamaList.filter(c=>c.outcome==='أصرّ على الخروج').length;
  DATA.seq++;
  const report = {
    id:'dr'+DATA.seq, repId:SESSION.repId||'', name:SESSION.repName||'', branch:SESSION.branch,
    date, tasks:JSON.stringify(tasks), patientsCount:document.getElementById('drPatients').value||0,
    dischargeCount:document.getElementById('drDischarge').value||0, complaints:JSON.stringify(complaints),
    satisfaction:document.getElementById('drSatisfaction').value,
    escalated:document.getElementById('drEscalated').value, extraNotes:document.getElementById('drNotes').value,
    hisDocumented:document.getElementById('drHis').value||0, amaDamaCases:JSON.stringify(amaDamaList),
    amaDamaTotal:amaDamaList.length, convinced, insisted,
    submittedAt:new Date().toISOString()
  };
  DATA.dailyReports.push({...report, tasks, complaints, amaDamaCases:amaDamaList});
  pushAppend('DailyReports', report);
  save();
  statusEl.style.display='block'; statusEl.style.color='#1D9E75';
  statusEl.textContent='✅ تم إرسال التقرير — وصل لدائرتك (المشرفة والمدير) مباشرة.';
  setTimeout(()=> navigate('dailyreport'), 1800);
}

/* ================= DAILY REPORTS (director/supervisor review) ================= */
function renderDailyReports(){
  const branches = scopedBranches();
  const list = (DATA.dailyReports||[]).filter(r=>branches.includes(r.branch)).sort((a,b)=> new Date(b.submittedAt)-new Date(a.submittedAt));
  document.getElementById('view').innerHTML = `
    <div class="panel">
      <table><thead><tr><th>الموظفة</th><th>الفرع</th><th>التاريخ</th><th>الشكاوى</th><th>AMA/DAMA</th><th>التصعيد</th><th></th></tr></thead>
      <tbody id="drBody"></tbody></table>
    </div>
    <div id="drDetail"></div>`;
  document.getElementById('drBody').innerHTML = list.map(r=>`
    <tr class="clickable" onclick="openDailyReportDetail('${r.id}')">
      <td>${r.name||'—'}</td><td>${DATA.branchName[r.branch]||r.branch}</td><td>${r.date}</td>
      <td>${(r.complaints||[]).length}</td><td>${r.amaDamaTotal||0}</td>
      <td>${r.escalated==='نعم' ? '<span class="badge b-dark">نعم</span>' : (r.escalated||'—')}</td>
      <td>عرض ▾</td>
    </tr>`).join('') || `<tr><td colspan="7" class="empty">لا توجد تقارير يومية بعد</td></tr>`;
}
function openDailyReportDetail(id){
  const r = (DATA.dailyReports||[]).find(x=>x.id===id);
  if(!r) return;
  const tasksHTML = (r.tasks||[]).map(t=>`<span class="badge b-blue">${t}</span>`).join(' ') || '<span class="empty" style="padding:0;">لا يوجد</span>';
  const compHTML = (r.complaints||[]).map(c=>{
    const icon = COMPLAINT_TYPES[c.type]?.icon || '📝';
    const rows = Object.entries(c).filter(([k,v])=>k!=='type'&&k!=='resolved'&&v).map(([k,v])=>`<div class="timeline-item"><div class="td">${k}: ${v}</div></div>`).join('');
    return `<div class="panel" style="margin-bottom:8px;"><b>${icon} ${c.type}</b> ${c.resolved?`<span class="badge b-mid">${c.resolved}</span>`:''}${rows}</div>`;
  }).join('') || '<p class="empty">لا توجد شكاوى بهذا التقرير</p>';
  const amaDamaHTML = (r.amaDamaCases||[]).map(c=>`
    <div class="panel" style="margin-bottom:8px;">
      <b>🚪 ${c.patient||'—'}</b> <span class="badge ${c.outcome==='أصرّ على الخروج'?'b-dark':'b-blue'}">${c.outcome}</span>
      <div class="timeline-item"><div class="td">القسم: ${c.dept||'—'} · الغرفة: ${c.room||'—'}</div></div>
      ${c.reason?`<div class="timeline-item"><div class="td">سبب الخروج: ${c.reason}</div></div>`:''}
      ${c.notes?`<div class="timeline-item"><div class="td">ملاحظات: ${c.notes}</div></div>`:''}
    </div>`).join('') || '<p class="empty">لا توجد حالات AMA/DAMA بهذا التقرير</p>';
  document.getElementById('drDetail').innerHTML = `
    <div class="section-title">تفاصيل تقرير ${r.name} — ${r.date}</div>
    <div class="grid-2">
      <div class="panel">
        <h3>المهام المنجزة</h3><div>${tasksHTML}</div>
        <div class="patient-detail-grid" style="margin-top:14px;">
          <div><b>عدد الحالات المتابَعة</b>${r.patientsCount||0}</div>
          <div><b>حالات الخروج</b>${r.dischargeCount||0}</div>
          <div><b>حالات AMA/DAMA (إجمالي)</b>${r.amaDamaTotal||0}</div>
          <div><b>أُقنعوا بالاستمرار في العلاج</b>${r.convinced||0}</div>
          <div><b>رضا المرضى</b>${r.satisfaction||'—'}</div>
          <div><b>أصرّوا على الخروج</b>${r.insisted||0}</div>
          <div><b>موثّق بـ HIS</b>${r.hisDocumented||0}</div>
          <div><b>تصعيد للمدير</b>${r.escalated||'—'}</div>
        </div>
        <div style="margin-top:10px;"><b style="font-size:12px; color:var(--ink-soft);">ملاحظات:</b><p style="font-size:13px; margin-top:4px;">${r.extraNotes||'—'}</p></div>
      </div>
      <div>
        <h3 style="font-size:14.5px; color:var(--brand-darker); margin-bottom:10px;">الشكاوى والمشاكل</h3>${compHTML}
        <h3 style="font-size:14.5px; color:var(--brand-darker); margin:16px 0 10px;">حالات AMA/DAMA</h3>${amaDamaHTML}
      </div>
    </div>`;
}

function renderReports(){
  const branches = scopedBranches();
  const reportDefs = [
    {key:'issues', name:"تقرير المشكلات حسب الفرع", count:DATA.issues.filter(i=>branches.includes(i.branch)).length},
    {key:'tasks', name:"تقرير المهام الشهري", count:DATA.tasks.filter(t=>branches.includes(t.branch)).length},
    {key:'rounds', name:"تقرير الجولات اليومية", count:DATA.rounds.filter(r=>branches.includes(r.branch)).length},
    {key:'depts', name:"تقرير أداء الأقسام", count:DEPTS.length},
  ];
  document.getElementById('view').innerHTML = `
    <div class="panel">
      <table><thead><tr><th>اسم التقرير</th><th>عدد السجلات</th><th>تصدير</th></tr></thead>
      <tbody>${reportDefs.map(r=>`
        <tr><td>${r.name}</td><td>${r.count}</td>
        <td>
          <button class="btn btn-ghost btn-sm" onclick="exportReport('${r.key}','excel')">Excel</button>
          <button class="btn btn-ghost btn-sm" onclick="exportReport('${r.key}','pdf')">PDF</button>
        </td></tr>`).join('')}
      </tbody></table>
    </div>`;
}
function getReportRows(key){
  const branches = scopedBranches();
  if(key==='issues') return {
    headers:['العنوان','القسم','المسؤول','الفرع','الأولوية','الحالة','تاريخ الإنشاء'],
    rows: DATA.issues.filter(i=>branches.includes(i.branch)).map(i=>[i.title,i.dept,i.responsible||'',DATA.branchName[i.branch],i.priority,i.status,new Date(i.createdAt).toLocaleDateString('ar-SA')])
  };
  if(key==='tasks') return {
    headers:['المهمة','مسندة إلى','الفرع','الأولوية','الاستحقاق','الإنجاز','الحالة'],
    rows: DATA.tasks.filter(t=>branches.includes(t.branch)).map(t=>[t.title,t.owner,DATA.branchName[t.branch],t.priority,t.due,t.pct+'٪',t.status])
  };
  if(key==='rounds') return {
    headers:['الموظف','الفرع','القسم','الوقت','الرضا'],
    rows: DATA.rounds.filter(r=>branches.includes(r.branch)).map(r=>[r.employee,DATA.branchName[r.branch],r.dept,new Date(r.time).toLocaleString('ar-SA'),r.satisfaction])
  };
  if(key==='depts'){
    const counts = {}; DEPTS.forEach(d=>counts[d]=0);
    (DATA.notes||[]).filter(n=>branches.includes(n.branch)).forEach(n=>{ if(n.dept) counts[n.dept]=(counts[n.dept]||0)+1; });
    return { headers:['القسم','عدد الملاحظات'], rows: Object.entries(counts).map(([d,c])=>[d,c]) };
  }
  return {headers:[],rows:[]};
}
function getReportChartData(key, rows){
  const count = {};
  let idx;
  if(key==='issues') idx = 5; // الحالة
  else if(key==='tasks') idx = 6; // الحالة
  else if(key==='rounds') idx = 4; // الرضا
  if(key==='depts') return { labels: rows.map(r=>r[0]), data: rows.map(r=>r[1]) };
  rows.forEach(r=>{ const k=r[idx]||'—'; count[k]=(count[k]||0)+1; });
  return { labels:Object.keys(count), data:Object.values(count) };
}
function exportReport(key, type){
  const {headers, rows} = getReportRows(key);
  const titles = {issues:'تقرير المشكلات حسب الفرع', tasks:'تقرير المهام الشهري', rounds:'تقرير الجولات اليومية', depts:'تقرير أداء الأقسام'};
  const title = titles[key];
  if(rows.length===0){ alert('لا توجد بيانات لتصديرها بهذا التقرير حاليًا.'); return; }
  if(type==='excel'){
    let csv = '\uFEFF' + headers.join(',') + '\n' + rows.map(r=>r.map(c=>`"${String(c).replace(/"/g,'""')}"`).join(',')).join('\n');
    const blob = new Blob([csv], {type:'text/csv;charset=utf-8;'});
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = title + '.csv';
    link.click();
  }else{
    const chartData = getReportChartData(key, rows);
    const generatedBy = (SESSION.repName||SESSION.supName||ROLE_LABEL[SESSION.role]) + ' — ' + (SESSION.branch==='all'?'كل الفروع':DATA.branchName[SESSION.branch]);
    const w = window.open('', '_blank');
    w.document.write(`<html dir="rtl"><head><meta charset="utf-8"><title>${title}</title>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"><\/script>
      <style>
        body{font-family:'Times New Roman (Headings CS)','Times New Roman',serif; padding:28px; color:#12213B; background:#fff;}
        .hdr{display:flex; align-items:center; gap:14px; border-bottom:3px solid #1855A4; padding-bottom:14px; margin-bottom:18px;}
        .logo{width:56px; height:56px; border-radius:12px; background:#1855A4; color:#fff; display:flex; align-items:center; justify-content:center; font-weight:bold; font-size:20px;}
        h1{color:#0E3E7C; font-size:20px; margin-bottom:2px;} .sub{color:#4C5C77; font-size:12.5px;}
        .meta{display:flex; justify-content:space-between; font-size:12px; color:#4C5C77; margin-bottom:16px;}
        table{width:100%; border-collapse:collapse; margin-top:10px;} th,td{border:1px solid #DCE4F0; padding:8px; text-align:right; font-size:13px;} th{background:#EAF1FA; color:#092A56;}
        .chartbox{max-width:520px; margin:0 auto 20px;}
        @media print{ .noprint{display:none;} }
      </style>
      </head><body>
      <div class="hdr"><div class="logo">AH</div><div><h1>مستشفى الحمادي — منصة إدارة التنويم</h1><div class="sub">${title}</div></div></div>
      <div class="meta"><span>تاريخ الإصدار: ${new Date().toLocaleString('ar-SA')}</span><span>بواسطة: ${generatedBy}</span></div>
      <div class="chartbox"><canvas id="rc"></canvas></div>
      <table><thead><tr>${headers.map(h=>`<th>${h}</th>`).join('')}</tr></thead>
      <tbody>${rows.map(r=>`<tr>${r.map(c=>`<td>${c}</td>`).join('')}</tr>`).join('')}</tbody></table>
      <script>
        window.onload = function(){
          new Chart(document.getElementById('rc'), {
            type:'bar',
            data:{ labels:${JSON.stringify(chartData.labels)}, datasets:[{data:${JSON.stringify(chartData.data)}, backgroundColor:'#1855A4', borderRadius:5}] },
            options:{ plugins:{legend:{display:false}}, responsive:true }
          });
          setTimeout(function(){ window.print(); }, 600);
        };
      <\/script>
      </body></html>`);
    w.document.close();
  }
}


/* ================= ANALYTICS ================= */
function renderAnalytics(){
  const branches = scopedBranches();
  const notes = (DATA.notes||[]).filter(n=>branches.includes(n.branch));
  const deptNoteCounts = {};
  DEPTS.forEach(d=> deptNoteCounts[d]=0);
  notes.forEach(n=>{ if(n.dept) deptNoteCounts[n.dept]=(deptNoteCounts[n.dept]||0)+1; });
  const ranked = Object.entries(deptNoteCounts).sort((a,b)=>b[1]-a[1]);
  const highest = ranked.slice(0,5);
  const lowest = [...ranked].reverse().slice(0,5);
  document.getElementById('view').innerHTML = `
    <div class="section-title">ترتيب الأقسام حسب الملاحظات</div>
    <div class="grid-2">
      <div class="panel"><h3>⚠ الأعلى ملاحظات <span class="tag">يحتاج متابعة</span></h3>
        <table><tbody>${highest.map(([d,c])=>`<tr><td>${d}</td><td>${c} ملاحظة</td></tr>`).join('')}</tbody></table>
      </div>
      <div class="panel"><h3>✅ الأقل ملاحظات <span class="tag">يستاهل شكر</span></h3>
        <table><tbody>${lowest.map(([d,c])=>`<tr><td>${d}</td><td>${c} ملاحظة</td></tr>`).join('')}</tbody></table>
      </div>
    </div>
    <div class="section-title">مؤشرات عامة</div>
    <div class="grid-2">
      <div class="panel"><h3>المشكلات حسب القسم</h3><canvas id="chDept"></canvas></div>
      <div class="panel"><h3>الأولويات — المهام المفتوحة</h3><canvas id="chPriority"></canvas></div>
    </div>`;
  const deptCounts = {};
  DATA.issues.filter(i=>branches.includes(i.branch)).forEach(i=>{ deptCounts[i.dept]=(deptCounts[i.dept]||0)+1; });
  if(charts.dept) charts.dept.destroy();
  charts.dept = new Chart(document.getElementById('chDept'), {
    type:'bar', data:{labels:Object.keys(deptCounts), datasets:[{data:Object.values(deptCounts), backgroundColor:'#1855A4', borderRadius:6}]},
    options:{plugins:{legend:{display:false}}, indexAxis:'y'}
  });
  const prios = ["منخفضة","متوسطة","عالية","عاجلة"];
  const prioCounts = prios.map(p=> DATA.tasks.filter(t=>branches.includes(t.branch) && t.status!=='مكتملة' && t.priority===p).length);
  if(charts.prio) charts.prio.destroy();
  charts.prio = new Chart(document.getElementById('chPriority'), {
    type:'doughnut', data:{labels:prios, datasets:[{data:prioCounts, backgroundColor:['#B9CEE9','#8FB3DE','#4A7CC4','#0E3E7C']}]},
    options:{plugins:{legend:{position:'bottom', labels:{font:{family:'Times New Roman', size:11}}}}}
  });
}

/* ================= SETTINGS ================= */
function renderSettings(){
  const branches = scopedBranches();
  const reps = DATA.reps.filter(r=>branches.includes(r.branch));
  const branchOptions = SESSION.role==='director'
    ? Object.entries(DATA.branchName).map(([k,v])=>`<option value="${k}">${v}</option>`).join('')
    : `<option value="${SESSION.branch}">${DATA.branchName[SESSION.branch]}</option>`;
  document.getElementById('view').innerHTML = `
    <div class="grid-2">
      <div class="panel">
        <h3>الموظفات <span class="tag">${reps.length}</span></h3>
        <table><thead><tr><th>الاسم</th><th>الفرع</th><th></th></tr></thead>
        <tbody id="empBody">${reps.map(r=>`
          <tr><td>${r.name}</td><td>${DATA.branchName[r.branch]||r.branch}</td>
          <td><button class="btn btn-ghost btn-sm" onclick="resetRepPassword('${r.id}')">إعادة تعيين كلمة المرور</button></td></tr>`).join('') || `<tr><td colspan="3" class="empty">لا يوجد موظفات</td></tr>`}
        </tbody></table>
      </div>
      <div class="panel">
        <h3>إضافة موظفة جديدة</h3>
        <div class="field"><label>الاسم الكامل</label><input type="text" id="newEmpName" placeholder="مثال: نورة العتيبي"></div>
        <div class="field"><label>الفرع</label><select id="newEmpBranch">${branchOptions}</select></div>
        <div class="field"><label>كلمة مرور أولية</label><input type="text" id="newEmpPwd" placeholder="مثال: 1234" value="1234"></div>
        <button class="btn btn-primary" style="width:100%;" onclick="addNewEmployee()">＋ إضافة الموظفة</button>
        <p id="newEmpStatus" style="display:none; margin-top:10px; font-size:12.5px; text-align:center;"></p>
        <p style="font-size:11.5px; color:var(--ink-soft); margin-top:10px;">بعد الإضافة تقدرين تخبرين الموظفة باسمها وكلمة المرور الأولية، وهي تقدر تغيّرها بنفسها من زر "تغيير كلمة المرور" بعد أول تسجيل دخول.</p>
      </div>
    </div>
    <div class="grid-2" style="margin-top:16px;">
      <div class="panel"><h3>الفروع</h3><table><tbody>${Object.entries(DATA.branchName).map(([k,v])=>`<tr><td>${v}</td><td>${(DATA.notes||[]).filter(n=>n.branch===k).length} ملاحظة مسجّلة</td></tr>`).join('')}</tbody></table></div>
    </div>`;
}
function addNewEmployee(){
  const name = document.getElementById('newEmpName').value.trim();
  const branch = document.getElementById('newEmpBranch').value;
  const pwd = document.getElementById('newEmpPwd').value.trim() || '1234';
  const statusEl = document.getElementById('newEmpStatus');
  if(!name){ statusEl.style.display='block'; statusEl.style.color='#B3261E'; statusEl.textContent='اكتبي اسم الموظفة أولاً.'; return; }
  DATA.seq++;
  const rep = {id:'rep'+DATA.seq, name, branch, password:pwd};
  DATA.reps.push(rep);
  pushAppend('Reps', rep);
  save();
  statusEl.style.display='block'; statusEl.style.color='#1D9E75';
  statusEl.textContent = `✅ تمت إضافة "${name}" — كلمة المرور الأولية: ${pwd}`;
  document.getElementById('newEmpName').value='';
  renderSettings();
}
function resetRepPassword(id){
  const rep = DATA.reps.find(r=>r.id===id);
  if(!rep) return;
  const newPwd = prompt(`كلمة مرور جديدة لـ ${rep.name}:`, '1234');
  if(!newPwd) return;
  rep.password = newPwd;
  pushUpdate('Reps', id, {password:newPwd});
  save();
  alert(`تم تعيين كلمة المرور الجديدة لـ ${rep.name}: ${newPwd}`);
}

/* ================= UTIL ================= */
function closeOverlay(id){ document.getElementById(id).classList.remove('show'); }
document.getElementById('globalSearch').addEventListener('keydown', e=>{
  if(e.key==='Enter'){ navigate('patients'); setTimeout(()=>{ document.getElementById('pSearch').value = e.target.value; document.getElementById('pSearch').dispatchEvent(new Event('input')); }, 30); }
});
</script>
</body>
</html>
